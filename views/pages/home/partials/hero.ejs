<section class="home-hero" aria-labelledby="home-heading" data-home-hero>
  <div class="app-content-frame home-hero__outer">
    <div class="home-hero__frame">
      <figure class="home-hero__media">
        <img
          src="<%= venuePackage.home.hero.image.src %>"
          alt="<%= venuePackage.home.hero.image.alt %>"
          width="<%= venuePackage.home.hero.image.width %>"
          height="<%= venuePackage.home.hero.image.height %>"
          fetchpriority="high"
          decoding="async"
          class="home-hero__image w-full">
        <figcaption class="home-hero__caption"><%= venuePackage.home.hero.image.caption %></figcaption>
      </figure>

      <div class="home-hero__copy">
        <p class="home-hero__location"><%= business.address %></p>
        <h1 id="home-heading"><%= siteName %></h1>
        <p class="home-hero__lede"><%= venuePackage.home.hero.lede %></p>
        <div class="home-hero__actions">
          <a href="/community" class="button-primary home-hero__primary">See what’s happening</a>
          <a href="#visit" class="button-secondary home-hero__secondary">Plan your visit</a>
        </div>
        <p class="home-hero__footnote"><%= venuePackage.home.hero.footnote %></p>
      </div>
    </div>
  </div>
</section>
