<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../_head', { graph, pageTitle }) %>
  <link rel="stylesheet" href="/css/candidate-c-social-read.css">
</head>
<body class="cc-public cc-editorial cc-social cc-social--editorial" style="--cc-accent:<%= graph.presentation.accent %>">
  <header class="cc-editorial-nav cc-social-nav">
    <a class="cc-editorial-name" href="<%= hostHref %>"><%- include('../_logo', { logoMedia }) %><span><%= graph.identity.displayName %></span></a>
    <nav aria-label="Community">
      <a href="<%= communityHref %>">Correspondence</a>
      <a aria-current="page" href="<%= socialHref %>">Dispatches & people</a>
      <a href="<%= hostHref %>">Host index</a>
    </nav>
  </header>
  <main class="cc-social-shell cc-social-editorial-shell">
    <header class="cc-social-mast cc-social-mast--editorial">
      <p class="cc-editorial-index">COMMUNITY / CURRENT</p>
      <div><h1>Dispatches & contributors</h1><p>A living index of public notes, stories, and people around <%= graph.identity.displayName %>, translated into this host’s editorial language.</p></div>
    </header>
    <%- include('_hub', {
      graph, hub, participation, hubStateCopy, formatCommunityTime, memberHref, discussionHref, contentPostEndpoint,
      socialOrder: ['posts', 'threads', 'people'],
      identityLabels: {
        kicker: 'Reader identity',
        title: 'Sign the register',
        body: 'Prove which Hive account is yours when you want to participate here. The publication remains readable without identification.',
        unavailableTitle: 'The register is temporarily closed',
        verifiedLabel: 'Verified reader',
        disconnect: 'Leave the register',
        accountLabel: 'Hive account',
        placeholder: 'reader-account',
        action: 'Verify my identity',
        ready: 'Identity is optional until a participation action actually needs it.'
      },
      communityParticipationLabels: {
        kicker: 'Community register',
        title: 'Choose your subscription',
        body: 'Keep this Hive community in your account’s subscriptions, or remove it deliberately.',
        identifyTitle: 'Sign the reader register first',
        identifyAction: 'Verify identity',
        unavailableTitle: 'Subscription status is unavailable',
        currentLabel: 'Hive subscription',
        currentYes: 'Subscribed',
        currentNo: 'Not subscribed',
        join: 'Subscribe to community',
        leave: 'Unsubscribe',
        ready: 'Review the exact Hive community operation before your wallet opens.'
      },
      contentPostLabels: {
        kicker: 'Contribute',
        title: 'Prepare a new dispatch',
        body: 'Draft a public Hive post for this publication context, then review the exact public operation before signing.',
        titleLabel: 'Headline',
        bodyLabel: 'Dispatch body',
        previewKicker: 'Proof',
        previewTitleEmpty: 'Untitled dispatch',
        previewBodyEmpty: 'Your dispatch proof will appear here.',
        action: 'Review dispatch',
        truth: 'The draft stays local until you deliberately continue to your wallet.',
        ready: 'Compose and revise before anything becomes public.'
      },
      socialLabels: {
        state: 'Transmission status',
        community: 'Community context',
        threadsKicker: 'Marginalia',
        threadsTitle: 'Short notes in circulation',
        postsKicker: 'Dispatches',
        postsTitle: 'Recent field notes',
        peopleKicker: 'Contributors',
        peopleTitle: 'People in this issue',
        peopleBody: 'Public profiles appearing in recent material or the community subscriber index.',
        quiet: 'No new dispatches are indexed yet.'
      }
    }) %>
  </main>
  <footer class="cc-editorial-footer"><span><%= graph.identity.displayName %></span><span>Public reads / wallet-owned participation</span></footer>
  <script src="/js/keychain-adapter.js" defer></script>
  <script src="/js/hivenues-identity.js" defer></script>
  <script src="/js/hivenues-participation.js" defer></script>
  <script src="/js/hivenues-content.js" defer></script>
</body>
</html>
