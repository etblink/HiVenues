<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { graph, pageTitle }) %>
</head>
<body class="cc-task-body">
<%
  const v = typeof values === 'object' && values ? values : graph.gallery;
  const selectedIds = Array.isArray(v.mediaIds) ? v.mediaIds : [];
  const orderById = new Map(selectedIds.map((id, index) => [id, index + 1]));
%>
  <main class="cc-task">
    <nav class="cc-task-nav">
      <a class="cc-link" href="/candidate-c/studio/<%= graph.identity.slug %>/territory-content">Back to territory content</a>
      <span class="cc-draft-status">Working Version <%= revision %></span>
    </nav>
    <p class="cc-kicker">Territory · Gallery</p>
    <h1>Curate media already owned by this host.</h1>
    <p class="cc-task__dek">Gallery authoring never uploads to an outside provider. Select from the existing Media library and give each selected item an order number. Unselected media remains available elsewhere in the territory.</p>

    <% if (errors.length) { %><section class="cc-conflict" role="alert"><strong>Check this gallery.</strong><ul><% errors.forEach((error) => { %><li><%= error.path %>: <%= error.message %></li><% }) %></ul></section><% } %>

    <form class="cc-setup-form" method="post" action="/candidate-c/studio/<%= graph.identity.slug %>/territory-content/gallery">
      <input type="hidden" name="expectedRevision" value="<%= revision %>">
      <input type="hidden" name="expectedDraftDigest" value="<%= draftDigest %>">
      <div class="cc-field"><label for="cc-gallery-title">Gallery title</label><input id="cc-gallery-title" name="title" maxlength="120" required value="<%= v.title ?? graph.gallery.title %>"></div>
      <div class="cc-field"><label for="cc-gallery-summary">Gallery introduction</label><textarea id="cc-gallery-summary" name="summary" maxlength="600" required><%= v.summary ?? graph.gallery.summary %></textarea></div>

      <fieldset class="cc-field"><legend>Media and order</legend>
        <% graph.media.forEach((media, index) => { const checked = orderById.has(media.id); %>
          <div>
            <label><input type="checkbox" name="include_<%= index %>" value="1" <%= checked ? 'checked' : '' %>> <strong><%= media.alt %></strong> <small>(<%= media.kind %>)</small></label>
            <label for="cc-gallery-order-<%= index %>">Order <input id="cc-gallery-order-<%= index %>" type="number" name="order_<%= index %>" min="1" max="60" value="<%= orderById.get(media.id) || index + 1 %>"></label>
            <small><%= media.provenance %></small>
          </div>
        <% }) %>
      </fieldset>

      <button class="cc-button cc-button--ink" type="submit">Save gallery to Working</button>
    </form>
  </main>
</body>
</html>
