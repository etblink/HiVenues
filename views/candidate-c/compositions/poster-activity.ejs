<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../_head', { graph, pageTitle }) %>
</head>
<body class="cc-public cc-poster cc-activity-page" style="--cc-accent:<%= graph.presentation.accent %>">
  <header class="cc-poster-nav">
    <a class="cc-wordmark" href="/candidate-c/<%= graph.identity.slug %>"><%= graph.identity.displayName %></a>
    <a class="cc-link cc-link--light" href="/candidate-c/<%= graph.identity.slug %>">Back to the room</a>
  </header>
  <main class="cc-poster-activity">
    <section class="cc-poster-activity__bill">
      <div>
        <p class="cc-kicker">One night at <%= graph.identity.displayName %></p>
        <h1><%= activity.title %></h1>
        <p class="cc-time"><%= activity.humanTime %></p>
        <p class="cc-poster-activity__description"><%= activity.description %></p>
      </div>
      <%- include('../_art', { media: activity.media, graph }) %>
    </section>

    <section class="cc-action-dock" aria-labelledby="cc-come-through">
      <div>
        <p class="cc-kicker">Come through</p>
        <h2 id="cc-come-through"><%= activity.presence.venueName %></h2>
        <p><%= activity.presence.address %></p>
      </div>
      <form class="cc-rsvp" method="post" action="/candidate-c/<%= graph.identity.slug %>/activities/<%= activity.slug %>/rsvp" hx-post="/candidate-c/<%= graph.identity.slug %>/activities/<%= activity.slug %>/rsvp" hx-target="#cc-rsvp-result" hx-swap="innerHTML">
        <label for="cc-rsvp-name">Name</label>
        <div class="cc-rsvp__row">
          <input id="cc-rsvp-name" name="name" autocomplete="name" maxlength="80" placeholder="Your name">
          <button class="cc-button cc-button--warm" type="submit"><%= graph.voice.terms.rsvp_local %></button>
        </div>
        <div id="cc-rsvp-result" aria-live="polite"></div>
      </form>
      <div class="cc-action-dock__links">
        <a class="cc-link cc-link--light" href="/candidate-c/<%= graph.identity.slug %>/activities/<%= activity.slug %>/calendar.ics"><%= graph.voice.terms.calendar_ics %></a>
        <a class="cc-link cc-link--light" href="/candidate-c/<%= graph.identity.slug %>/consequence/applaud_hive"><%= graph.voice.terms.applaud_hive %></a>
      </div>
    </section>
  </main>
  <script src="/htmx/htmx.min.js" defer></script>
</body>
</html>
