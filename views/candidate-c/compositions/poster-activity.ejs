<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../_head', { graph, pageTitle }) %>
</head>
<%
  const previewMode = typeof draftPreview !== 'undefined' && draftPreview === true;
  const hostHref = previewMode ? `/candidate-c/studio/${encodeURIComponent(graph.identity.slug)}/preview` : `/candidate-c/${encodeURIComponent(graph.identity.slug)}`;
  const activityHref = `${hostHref}/activities/${encodeURIComponent(activity.slug)}`;
  const calendarHref = `${activityHref}/calendar.ics`;
  const consequenceHref = previewMode ? `${hostHref}/consequence/applaud_hive` : `/candidate-c/${encodeURIComponent(graph.identity.slug)}/consequence/applaud_hive`;
  const rsvpHref = `/candidate-c/${encodeURIComponent(graph.identity.slug)}/activities/${encodeURIComponent(activity.slug)}/rsvp`;
%>
<body class="cc-public cc-poster cc-activity-page" style="--cc-accent:<%= graph.presentation.accent %>">
  <header class="cc-poster-nav">
    <a class="cc-wordmark" href="<%= hostHref %>"><%= graph.identity.displayName %></a>
    <a class="cc-link cc-link--light" href="<%= hostHref %>">Back to <%= graph.identity.displayName %></a>
  </header>
  <main class="cc-poster-activity">
    <section class="cc-poster-activity__bill">
      <div>
        <p class="cc-kicker">At <%= graph.identity.displayName %></p>
        <h1><%= activity.title %></h1>
        <%- include('../_status', { activity }) %>
        <p class="cc-time"><%= activity.humanTime %></p>
        <p class="cc-poster-activity__description"><%= activity.description %></p>
      </div>
      <%- include('../_art', { media: activity.media, graph }) %>
    </section>

    <section class="cc-action-dock" aria-labelledby="cc-come-through">
      <div>
        <p class="cc-kicker"><%= activity.presence.mode === 'online' ? 'Join online' : activity.presence.mode === 'hybrid' ? 'Join in person or online' : 'Come through' %></p>
        <h2 id="cc-come-through"><%= activity.presence.mode === 'online' ? activity.presence.platformLabel : activity.presence.venueName %></h2>
        <% if (activity.presence.mode !== 'online') { %><p><%= activity.presence.address %></p><% } %>
        <% if (activity.presence.mode === 'hybrid') { %><p><%= activity.presence.platformLabel %></p><% } %>
      </div>
      <% if (previewMode) { %>
      <div class="cc-rsvp cc-rsvp--closed" data-draft-preview-action>
        <p><strong>Draft preview.</strong> Visitor RSVP is not active here. Release this working version to make visitor actions available.</p>
      </div>
      <% } else if (activity.open) { %>
      <form class="cc-rsvp" method="post" action="<%= rsvpHref %>" hx-post="<%= rsvpHref %>" hx-target="#cc-rsvp-result" hx-swap="innerHTML">
        <label for="cc-rsvp-name">Name</label>
        <div class="cc-rsvp__row">
          <input id="cc-rsvp-name" name="name" autocomplete="name" maxlength="80" placeholder="Your name">
          <button class="cc-button cc-button--warm" type="submit"><%= graph.voice.terms.rsvp_local %></button>
        </div>
        <div id="cc-rsvp-result" aria-live="polite"></div>
      </form>
      <% } else { %>
      <div class="cc-rsvp cc-rsvp--closed" data-rsvp-closed>
        <p><strong><%= activity.lifecycle === 'cancelled' ? 'Cancelled' : 'Already happened' %>.</strong> RSVPs are closed for this one.</p>
      </div>
      <% } %>
      <div class="cc-action-dock__links">
        <a class="cc-link cc-link--light" href="<%= calendarHref %>"><%= graph.voice.terms.calendar_ics %></a>
        <a class="cc-link cc-link--light" href="<%= consequenceHref %>"><%= graph.voice.terms.applaud_hive %></a>
      </div>
    </section>
  </main>
  <script src="/htmx/htmx.min.js" defer></script>
</body>
</html>
