<section class="cc-canvas-complete" aria-label="Complete visitor content represented in Studio">
  <header class="cc-canvas-complete__head">
    <div>
      <p class="cc-kicker">Visitor page · complete content</p>
      <h2><%= graph.facts.summary %></h2>
    </div>
    <a class="cc-edit-chip" href="/candidate-c/studio/<%= graph.identity.slug %>/content">Edit content & visit facts</a>
  </header>

  <% if (logoMedia && logoMedia.asset) { %>
    <div class="cc-canvas-complete__logo"><img src="<%= logoMedia.asset.path %>" alt="<%= logoMedia.alt %>"></div>
  <% } %>

  <div class="cc-canvas-complete__grid">
    <article>
      <p class="cc-kicker">Story</p>
      <p class="cc-canvas-complete__story"><%= graph.intent.presenceMaterial %></p>
      <p><%= graph.intent.purpose %></p>
    </article>
    <article>
      <p class="cc-kicker">Visit</p>
      <strong><%= graph.facts.presence.label %></strong>
      <% if (graph.facts.presence.address) { %><p><%= graph.facts.presence.address %></p><% } %>
      <p><% if (contact.href) { %><a href="<%= contact.href %>"><%= contact.label %></a><% } else { %><%= contact.label %><% } %></p>
    </article>
  </div>

  <% if (graph.offers.length) { %>
    <div class="cc-canvas-complete__offers">
      <p class="cc-kicker">Offerings</p>
      <% graph.offers.forEach((offer) => { %>
        <article><strong><%= offer.title %></strong><span><%= offer.summary %><% if (offer.price) { %> · <%= offer.price %><% } %></span></article>
      <% }) %>
    </div>
  <% } %>

  <div class="cc-canvas-complete__participation">
    <p class="cc-kicker">Invitation</p>
    <p><%= graph.intent.participation %></p>
  </div>
</section>
