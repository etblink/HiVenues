<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../_head', { graph, pageTitle }) %>
</head>
<%
  const hasRealHero = heroMedia.kind !== 'bootstrap-art' && heroMedia.asset;
  const sparseHost = !primaryActivity && graph.offers.length === 0;
%>
<body class="cc-public cc-editorial <%= hasRealHero ? 'cc-public--real-media' : 'cc-public--bootstrap-media' %> <%= sparseHost ? 'cc-public--sparse' : '' %>" style="--cc-accent:<%= graph.presentation.accent %>">
  <header class="cc-editorial-nav">
    <a class="cc-editorial-name" href="/candidate-c/<%= graph.identity.slug %>"><%- include('../_logo', { logoMedia }) %><span><%= graph.identity.displayName %></span></a>
    <nav aria-label="Primary">
      <% if (primaryActivity) { %><a href="#current">Activity</a><% } %>
      <a href="#notes">Story</a>
      <a href="#about">About</a>
    </nav>
  </header>

  <main class="cc-editorial-page">
    <% graph.presentation.arrangement.forEach((section) => { %>
      <% if (section === 'story') { %>
        <section class="cc-editorial-deck" id="notes">
          <p class="cc-editorial-index">01 / CONTEXT</p>
          <div>
            <p><%= graph.intent.presenceMaterial %></p>
            <p><%= graph.intent.purpose %></p>
            <p><strong><%= graph.intent.participation %></strong></p>
          </div>
        </section>
      <% } %>

      <% if (section === 'hero') { %>
        <section class="cc-editorial-hero" aria-labelledby="cc-editorial-title">
          <div class="cc-editorial-hero__copy">
            <p class="cc-kicker"><%= graph.identity.archetype %></p>
            <h1 id="cc-editorial-title"><%= graph.facts.tagline %></h1>
            <p class="cc-editorial-hero__summary"><%= graph.facts.summary %></p>
          </div>
          <div class="cc-editorial-hero__media">
            <%- include('../_art', { media: heroMedia, graph }) %>
            <% if (heroMedia.kind !== 'bootstrap-art' && heroMedia.provenance) { %><p class="cc-media-note"><%= heroMedia.provenance %></p><% } %>
          </div>
        </section>
      <% } %>

      <% if (section === 'activity' && primaryActivity) { %>
        <section class="cc-editorial-session" id="current" aria-labelledby="cc-current-title">
          <div class="cc-editorial-session__meta">
            <p class="cc-editorial-index"><%= primaryActivity.lifecycle === 'scheduled' ? '02 / UPCOMING' : primaryActivity.lifecycle === 'cancelled' ? '02 / UPDATE' : '02 / PAST' %></p>
            <p class="cc-time"><%= primaryActivity.humanTime %></p>
          </div>
          <div class="cc-editorial-session__body">
            <h2 id="cc-current-title"><%= primaryActivity.title %></h2>
            <%- include('../_status', { activity: primaryActivity }) %>
            <p><%= primaryActivity.description %></p>
            <div class="cc-editorial-session__actions">
              <a class="cc-button cc-button--ink" href="/candidate-c/<%= graph.identity.slug %>/activities/<%= primaryActivity.slug %>"><%= primaryActivity.lifecycle === 'scheduled' ? 'Open activity' : 'Activity details' %></a>
              <a class="cc-link" href="/candidate-c/<%= graph.identity.slug %>/activities/<%= primaryActivity.slug %>/calendar.ics"><%= graph.voice.terms.calendar_ics %></a>
            </div>
          </div>
        </section>
      <% } %>

      <% if (section === 'offer' && graph.offers.length) { %>
        <section class="cc-editorial-offer">
          <p class="cc-editorial-index">03 / OFFERINGS</p>
          <div>
            <% graph.offers.forEach((offer) => { %>
              <article style="margin-bottom:1.5rem">
                <% if (offer.category) { %><p class="cc-kicker"><%= offer.category %></p><% } %>
                <h2><%= offer.title %></h2>
                <p><%= offer.summary %></p>
                <% if (offer.price) { %><p><strong><%= offer.price %></strong></p><% } %>
                <% if (contact.href) { %><a class="cc-link" href="<%= contact.href %>">Ask about <%= offer.title %></a><% } %>
              </article>
            <% }) %>
          </div>
        </section>
      <% } %>

      <% if (section === 'details') { %>
        <section class="cc-editorial-about" id="about">
          <p class="cc-editorial-index">04 / WHERE</p>
          <div>
            <h2><%= graph.facts.presence.label %></h2>
            <% if (graph.facts.presence.address) { %><p><strong>Address</strong><br><%= graph.facts.presence.address %></p><% } %>
            <p><%= graph.intent.participation %></p>
            <% if (contact.href) { %><a class="cc-link" href="<%= contact.href %>"><%= contact.label %></a><% } else { %><p><%= contact.label %></p><% } %>
          </div>
        </section>
      <% } %>
    <% }) %>
  </main>

  <footer class="cc-editorial-footer">
    <span><%= graph.identity.displayName %></span>
    <span><%= graph.facts.presence.label %></span>
  </footer>
</body>
</html>
