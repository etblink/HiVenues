<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../_head', { graph, pageTitle }) %>
</head>
<%
  const hasRealHero = heroMedia.kind !== 'bootstrap-art' && heroMedia.asset;
  const sparseHost = !primaryActivity && graph.offers.length === 0;
  const previewMode = typeof draftPreview !== 'undefined' && draftPreview === true;
  const hostHref = previewMode ? `/candidate-c/studio/${encodeURIComponent(graph.identity.slug)}/preview` : `/candidate-c/${encodeURIComponent(graph.identity.slug)}`;
  const activityHref = (activity) => `${hostHref}/activities/${encodeURIComponent(activity.slug)}`;
  const calendarHref = (activity) => `${activityHref(activity)}/calendar.ics`;
%>
<body class="cc-public cc-poster <%= hasRealHero ? 'cc-public--real-media' : 'cc-public--bootstrap-media' %> <%= sparseHost ? 'cc-public--sparse' : '' %>" style="--cc-accent:<%= graph.presentation.accent %>">
  <header class="cc-poster-nav">
    <a class="cc-wordmark" href="<%= hostHref %>"><%- include('../_logo', { logoMedia }) %><span><%= graph.identity.displayName %></span></a>
    <nav aria-label="Primary">
      <% if (primaryActivity) { %><a href="#what-is-on">Activity</a><% } %>
      <% if (discoverableActivities.length) { %><a href="#more-activities">More</a><% } %>
      <a href="#visit">Where</a>
      <a href="#story">Story</a>
    </nav>
  </header>

  <main>
    <% graph.presentation.arrangement.forEach((section) => { %>
      <% if (section === 'hero') { %>
        <section class="cc-poster-hero" aria-labelledby="cc-poster-title">
          <div class="cc-poster-hero__copy">
            <p class="cc-kicker"><%= graph.identity.archetype %></p>
            <h1 id="cc-poster-title"><%= graph.facts.tagline %></h1>
            <p class="cc-poster-hero__summary"><%= graph.facts.summary %></p>
            <% if (primaryActivity) { %>
              <a class="cc-button cc-button--warm" href="<%= activityHref(primaryActivity) %>"><%= primaryActivity.lifecycle === 'cancelled' ? 'Activity update' : primaryActivity.lifecycle === 'completed' ? 'Activity recap' : `See ${primaryActivity.title}` %></a>
            <% } %>
          </div>
          <div class="cc-poster-hero__art">
            <%- include('../_art', { media: heroMedia, graph }) %>
            <% if (heroMedia.kind !== 'bootstrap-art' && heroMedia.provenance) { %><p class="cc-media-note"><%= heroMedia.provenance %></p><% } %>
          </div>
        </section>
      <% } %>

      <% if (section === 'activity' && primaryActivity) { %>
        <section class="cc-poster-night" id="what-is-on" aria-labelledby="cc-next-night">
          <div class="cc-poster-night__date" aria-hidden="true">
            <span><%= new Date(primaryActivity.startsAt).toLocaleDateString('en-US', { month: 'short', timeZone: graph.identity.timezone }).toUpperCase() %></span>
            <strong><%= new Date(primaryActivity.startsAt).toLocaleDateString('en-US', { day: '2-digit', timeZone: graph.identity.timezone }) %></strong>
          </div>
          <div class="cc-poster-night__body">
            <p class="cc-kicker"><%= primaryActivity.lifecycle === 'scheduled' ? `Next at ${graph.identity.displayName}` : primaryActivity.lifecycle === 'cancelled' ? 'Activity update' : `Previously at ${graph.identity.displayName}` %></p>
            <h2 id="cc-next-night"><%= primaryActivity.title %></h2>
            <%- include('../_status', { activity: primaryActivity }) %>
            <p class="cc-time"><%= primaryActivity.humanTime %></p>
            <p><%= primaryActivity.description %></p>
          </div>
          <div class="cc-poster-night__actions">
            <a class="cc-button" href="<%= activityHref(primaryActivity) %>"><%= primaryActivity.open ? 'Details & RSVP' : 'Activity details' %></a>
            <a class="cc-link" href="<%= calendarHref(primaryActivity) %>"><%= graph.voice.terms.calendar_ics %></a>
          </div>
        </section>

        <% if (discoverableActivities.length) { %>
          <section class="cc-poster-story" id="more-activities" aria-labelledby="cc-more-activities-title">
            <p class="cc-kicker">More on the wall</p>
            <h2 id="cc-more-activities-title">Other activities</h2>
            <% discoverableActivities.forEach((activity) => { %>
              <article style="margin-top:1.5rem">
                <p class="cc-time"><%= activity.humanTime %> · <%= activity.status.label %></p>
                <h3><a class="cc-link cc-link--light" href="<%= activityHref(activity) %>"><%= activity.title %></a></h3>
                <p class="cc-poster-story__small"><%= activity.description %></p>
              </article>
            <% }) %>
          </section>
        <% } %>
      <% } %>

      <% if (section === 'story') { %>
        <section class="cc-poster-story" id="story">
          <p class="cc-kicker">The place</p>
          <p class="cc-poster-story__line"><%= graph.intent.presenceMaterial %></p>
          <p class="cc-poster-story__small"><%= graph.intent.purpose %></p>
          <p class="cc-poster-story__small"><%= graph.intent.participation %></p>
        </section>
      <% } %>

      <% if (section === 'details') { %>
        <section class="cc-poster-visit" id="visit" aria-labelledby="cc-visit-title">
          <div>
            <p class="cc-kicker">Where to find us</p>
            <h2 id="cc-visit-title"><%= graph.facts.presence.label %></h2>
          </div>
          <div class="cc-poster-visit__facts">
            <% if (graph.facts.presence.address) { %><p><strong>Address</strong><br><%= graph.facts.presence.address %></p><% } %>
            <p><strong>Contact</strong><br><% if (contact.href) { %><a href="<%= contact.href %>"><%= contact.label %></a><% } else { %><%= contact.label %><% } %></p>
          </div>
        </section>
      <% } %>

      <% if (section === 'offer' && graph.offers.length) { %>
        <section class="cc-poster-offer">
          <p class="cc-kicker">From <%= graph.identity.displayName %></p>
          <% graph.offers.forEach((offer) => { %>
            <article style="margin-bottom:1.25rem">
              <% if (offer.category) { %><p class="cc-kicker"><%= offer.category %></p><% } %>
              <h2><%= offer.title %></h2>
              <p><%= offer.summary %></p>
              <% if (offer.price) { %><p><strong><%= offer.price %></strong></p><% } %>
              <% if (contact.href) { %><a class="cc-link cc-link--light" href="<%= contact.href %>">Ask about <%= offer.title %></a><% } %>
            </article>
          <% }) %>
        </section>
      <% } %>
    <% }) %>
  </main>

  <footer class="cc-poster-footer">
    <p><%= graph.identity.displayName %></p>
    <p><%= graph.facts.presence.label %></p>
  </footer>
</body>
</html>
