<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../_head', { graph, pageTitle }) %>
</head>
<body class="cc-public cc-editorial cc-activity-page" style="--cc-accent:<%= graph.presentation.accent %>">
  <header class="cc-editorial-nav">
    <a class="cc-editorial-name" href="/candidate-c/<%= graph.identity.slug %>"><%= graph.identity.displayName %></a>
    <a class="cc-link" href="/candidate-c/<%= graph.identity.slug %>">Back to field notes</a>
  </header>
  <main class="cc-editorial-activity">
    <section class="cc-editorial-activity__heading">
      <p class="cc-editorial-index">LIVE SESSION / <%= activity.humanTime %></p>
      <h1><%= activity.title %></h1>
      <%- include('../_status', { activity }) %>
      <p class="cc-editorial-activity__dek"><%= activity.description %></p>
    </section>

    <section class="cc-editorial-activity__media">
      <%- include('../_art', { media: activity.media, graph }) %>
      <p class="cc-media-note"><%= activity.media.provenance %></p>
    </section>

    <section class="cc-editorial-activity__participate">
      <div>
        <p class="cc-editorial-index">JOIN</p>
        <h2><%= activity.presence.platformLabel %></h2>
        <p>The session is online. RSVP is local to this HiVenues reference and does not create a platform account.</p>
      </div>
      <% if (activity.open) { %>
      <form class="cc-rsvp cc-rsvp--light" method="post" action="/candidate-c/<%= graph.identity.slug %>/activities/<%= activity.slug %>/rsvp" hx-post="/candidate-c/<%= graph.identity.slug %>/activities/<%= activity.slug %>/rsvp" hx-target="#cc-rsvp-result" hx-swap="innerHTML">
        <label for="cc-rsvp-name">Name</label>
        <div class="cc-rsvp__row">
          <input id="cc-rsvp-name" name="name" autocomplete="name" maxlength="80" placeholder="Your name">
          <button class="cc-button cc-button--ink" type="submit"><%= graph.voice.terms.rsvp_local %></button>
        </div>
        <div id="cc-rsvp-result" aria-live="polite"></div>
      </form>
      <% } else { %>
      <div class="cc-rsvp cc-rsvp--light cc-rsvp--closed" data-rsvp-closed>
        <p><strong><%= activity.lifecycle === 'cancelled' ? 'Cancelled' : 'Already happened' %>.</strong> RSVPs are closed for this one.</p>
      </div>
      <% } %>
      <div class="cc-editorial-session__actions">
        <a class="cc-link" href="/candidate-c/<%= graph.identity.slug %>/activities/<%= activity.slug %>/calendar.ics"><%= graph.voice.terms.calendar_ics %></a>
        <a class="cc-link" href="/candidate-c/<%= graph.identity.slug %>/consequence/applaud_hive"><%= graph.voice.terms.applaud_hive %></a>
      </div>
    </section>
  </main>
  <script src="/htmx/htmx.min.js" defer></script>
</body>
</html>
