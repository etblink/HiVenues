<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../_head', { graph, pageTitle }) %>
</head>
<body class="cc-public cc-hospitality" style="--cc-accent:<%= graph.presentation.accent %>">
  <header class="cc-hospitality-nav">
    <a class="cc-hospitality-name" href="/candidate-c/<%= graph.identity.slug %>"><%- include('../_logo', { logoMedia }) %><span><%= graph.identity.displayName %></span></a>
    <p><%= graph.facts.presence.label %></p>
    <nav aria-label="Primary">
      <% if (graph.offers.length) { %><a href="#menu">Offerings</a><% } %>
      <% if (primaryActivity) { %><a href="#table">What’s on</a><% } %>
      <a href="#visit">Visit</a>
    </nav>
  </header>

  <main>
    <% graph.presentation.arrangement.forEach((section) => { %>
      <% if (section === 'hero') { %>
        <section class="cc-hospitality-hero" aria-labelledby="cc-hospitality-title">
          <div class="cc-hospitality-hero__media">
            <%- include('../_art', { media: heroMedia, graph }) %>
            <% if (heroMedia.kind !== 'bootstrap-art' && heroMedia.provenance) { %><p class="cc-hospitality-caption"><%= heroMedia.provenance %></p><% } %>
          </div>
          <div class="cc-hospitality-hero__copy">
            <p class="cc-kicker"><%= graph.identity.archetype %></p>
            <h1 id="cc-hospitality-title"><%= graph.facts.tagline %></h1>
            <p><%= graph.facts.summary %></p>
            <div class="cc-hospitality-hero__actions">
              <% if (graph.offers.length) { %><a class="cc-button cc-button--hospitality" href="#menu">See what’s offered</a><% } %>
              <% if (primaryActivity) { %><a class="cc-link" href="/candidate-c/<%= graph.identity.slug %>/activities/<%= primaryActivity.slug %>">See <%= primaryActivity.title %></a><% } %>
            </div>
          </div>
        </section>
      <% } %>

      <% if (section === 'offer' && graph.offers.length) { %>
        <section class="cc-hospitality-menu" id="menu" aria-labelledby="cc-menu-title">
          <header>
            <p class="cc-kicker">From <%= graph.identity.displayName %></p>
            <h2 id="cc-menu-title">Current offerings</h2>
            <p><%= graph.intent.participation %></p>
          </header>
          <div class="cc-hospitality-menu__list">
            <% graph.offers.forEach((offer) => { %>
              <article class="cc-hospitality-dish">
                <div>
                  <% if (offer.category) { %><p class="cc-hospitality-dish__category"><%= offer.category %></p><% } %>
                  <h3><%= offer.title %></h3>
                  <p><%= offer.summary %></p>
                </div>
                <% if (offer.price) { %><strong><%= offer.price %></strong><% } %>
              </article>
            <% }) %>
          </div>
        </section>
      <% } %>

      <% if (section === 'story') { %>
        <section class="cc-hospitality-story">
          <p class="cc-hospitality-story__line"><%= graph.intent.presenceMaterial %></p>
          <div>
            <p class="cc-kicker">Why this place</p>
            <p><%= graph.intent.purpose %></p>
          </div>
        </section>
      <% } %>

      <% if (section === 'activity' && primaryActivity) { %>
        <section class="cc-hospitality-table" id="table" aria-labelledby="cc-table-title">
          <div class="cc-hospitality-table__date">
            <span>NEXT</span>
            <strong><%= new Date(primaryActivity.startsAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: graph.identity.timezone }) %></strong>
          </div>
          <div>
            <p class="cc-kicker">At <%= graph.identity.displayName %></p>
            <h2 id="cc-table-title"><%= primaryActivity.title %></h2>
            <%- include('../_status', { activity: primaryActivity }) %>
            <p class="cc-time"><%= primaryActivity.humanTime %></p>
            <p><%= primaryActivity.description %></p>
          </div>
          <div class="cc-hospitality-table__actions">
            <a class="cc-button cc-button--hospitality" href="/candidate-c/<%= graph.identity.slug %>/activities/<%= primaryActivity.slug %>"><%= primaryActivity.open ? graph.voice.terms.rsvp_local : 'About this activity' %></a>
            <a class="cc-link" href="/candidate-c/<%= graph.identity.slug %>/activities/<%= primaryActivity.slug %>/calendar.ics"><%= graph.voice.terms.calendar_ics %></a>
          </div>
        </section>
      <% } %>

      <% if (section === 'details') { %>
        <section class="cc-hospitality-visit" id="visit" aria-labelledby="cc-hospitality-visit-title">
          <div>
            <p class="cc-kicker"><%= graph.facts.presence.mode === 'online' ? 'Find us online' : 'Come by' %></p>
            <h2 id="cc-hospitality-visit-title"><%= graph.facts.presence.label %></h2>
          </div>
          <div class="cc-hospitality-visit__details">
            <% if (graph.facts.presence.address) { %><p><strong>Find us</strong><br><%= graph.facts.presence.address %></p><% } %>
            <p><strong>Contact</strong><br><% if (contact.href) { %><a href="<%= contact.href %>"><%= contact.label %></a><% } else { %><%= contact.label %><% } %></p>
          </div>
        </section>
      <% } %>
    <% }) %>
  </main>

  <footer class="cc-hospitality-footer">
    <span><%= graph.identity.displayName %></span>
    <span><%= graph.facts.presence.label %></span>
  </footer>
</body>
</html>
