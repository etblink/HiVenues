<main id="candidate-canvas" class="cc-studio-canvas cc-studio-canvas--hospitality" data-composition="hospitality" style="--cc-accent:<%= graph.presentation.accent %>;border-top:5px solid <%= graph.presentation.accent %>" <%= oob ? 'hx-swap-oob="outerHTML"' : '' %>>
  <div class="cc-canvas-hospitality__mast">
    <span><%= graph.identity.displayName %></span>
    <span><%= graph.facts.presence.label.split('·')[0].trim().toUpperCase() %></span>
  </div>
  <div class="cc-canvas-hospitality__hero">
    <div class="cc-canvas-hospitality__copy">
      <p class="cc-kicker"><%= graph.identity.archetype %></p>
      <h1><%= graph.facts.tagline %></h1>
      <p><%= graph.facts.summary %></p>
      <button type="button" class="cc-edit-chip" hx-get="/candidate-c/studio/<%= graph.identity.slug %>/inspect?resource=facts.tagline" hx-target="#candidate-inspector" hx-swap="outerHTML">Edit first impression</button>
    </div>
    <div class="cc-canvas-hospitality__media">
      <%- include('../_art', { media: heroMedia, graph }) %>
      <button type="button" class="cc-edit-chip" hx-get="/candidate-c/studio/<%= graph.identity.slug %>/inspect?resource=media:<%= heroMedia.id %>" hx-target="#candidate-inspector" hx-swap="outerHTML">Adjust image focus</button>
      <a class="cc-edit-chip" href="/candidate-c/studio/<%= graph.identity.slug %>/media-library"><%= heroMedia.kind === 'bootstrap-art' ? 'Import real image' : 'Replace image' %></a>
    </div>
  </div>
  <% if (graph.offers.length) { %>
  <section class="cc-canvas-hospitality__menu" aria-label="Current offerings preview">
    <span class="cc-kicker">Current offerings</span>
    <% graph.offers.slice(0, 3).forEach((offer) => { %>
      <article>
        <div><small><%= offer.category || 'Offering' %></small><strong><%= offer.title %></strong></div>
        <% if (offer.price) { %><span><%= offer.price %></span><% } %>
      </article>
    <% }) %>
  </section>
  <% } %>
  <% if (primaryActivity) { %>
    <article class="cc-canvas-hospitality__activity">
      <span class="cc-kicker">Next activity · <%= primaryActivity.humanTime %></span>
      <h2><%= primaryActivity.title %></h2>
      <%- include('../_status', { activity: primaryActivity }) %>
      <p><%= primaryActivity.description %></p>
      <button type="button" class="cc-edit-chip" hx-get="/candidate-c/studio/<%= graph.identity.slug %>/inspect?resource=activity:<%= primaryActivity.id %>" hx-target="#candidate-inspector" hx-swap="outerHTML">Edit activity</button>
    </article>
  <% } %>
  <%- include('_canvas-complete', { graph, contact, logoMedia }) %>
</main>
