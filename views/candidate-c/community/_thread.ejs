<%
  const stateCopy = communityStateCopy(community, graph.identity.displayName);
  const showThread = community.status === 'ready' || community.status === 'partial';
%>
<% if (showThread) { %>
  <% if (community.root) { %>
    <article class="cc-community-root">
      <div class="cc-community-root__meta">
        <p class="cc-kicker"><%= communityLabels.root %></p>
        <p class="cc-community-byline">@<%= community.root.authorKey %></p>
        <% const rootTime = formatCommunityTime(community.root.publishedAt, graph.identity.timezone); %>
        <% if (rootTime) { %><p class="cc-community-time"><%= rootTime %></p><% } %>
      </div>
      <div class="cc-community-root__body">
        <h2><%= community.root.title %></h2>
        <div class="cc-community-richtext"><%- community.root.bodyHtml %></div>
      </div>
    </article>
  <% } else { %>
    <section class="cc-community-state cc-community-state--partial" role="status">
      <p class="cc-kicker"><%= communityLabels.state %></p>
      <h2><%= stateCopy.heading %></h2>
      <p><%= stateCopy.body %></p>
    </section>
  <% } %>

  <% if (community.replies.length) { %>
    <section class="cc-community-replies" aria-labelledby="cc-community-replies-title">
      <header class="cc-community-replies__head">
        <p class="cc-kicker"><%= communityLabels.replies %></p>
        <h2 id="cc-community-replies-title"><%= community.replies.length === 1 ? '1 response' : `${community.replies.length} responses` %></h2>
      </header>
      <div class="cc-community-replies__list">
        <% community.replies.forEach((reply) => { %>
          <article class="cc-community-reply <%= replyDepthClass(reply.depth) %>">
            <div class="cc-community-reply__meta">
              <strong>@<%= reply.authorKey %></strong>
              <% const replyTime = formatCommunityTime(reply.publishedAt, graph.identity.timezone); %>
              <% if (replyTime) { %><span><%= replyTime %></span><% } %>
            </div>
            <div class="cc-community-richtext"><%- reply.bodyHtml %></div>
          </article>
        <% }) %>
      </div>
    </section>
  <% } else { %>
    <p class="cc-community-quiet"><%= communityLabels.quiet %></p>
  <% } %>
<% } else { %>
  <section class="cc-community-state cc-community-state--<%= community.status %>" role="status">
    <p class="cc-kicker"><%= communityLabels.state %></p>
    <h2><%= stateCopy.heading %></h2>
    <p><%= stateCopy.body %></p>
  </section>
<% } %>
