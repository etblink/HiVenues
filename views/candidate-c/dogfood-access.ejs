<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %></title>
  <link rel="stylesheet" href="/css/candidate-c.css">
</head>
<body class="cc-task-body">
  <main class="cc-task" style="max-width:42rem">
    <p class="cc-kicker">HiVenues · temporary dogfood access</p>
    <h1>Enter the test access phrase.</h1>
    <p class="cc-task__dek">This gate protects a temporary local Candidate C runtime exposed for operator testing. It is not a production account or authentication system.</p>
    <% if (failed) { %>
      <section class="cc-conflict" role="alert"><strong>That access phrase was not accepted.</strong></section>
    <% } %>
    <form class="cc-setup-form" method="post" action="/__dogfood/access">
      <div class="cc-field">
        <label for="cc-dogfood-secret">Access phrase</label>
        <input id="cc-dogfood-secret" name="accessSecret" type="password" autocomplete="current-password" required autofocus>
      </div>
      <button class="cc-button cc-button--ink" type="submit">Open dogfood Studio</button>
    </form>
  </main>
</body>
</html>
