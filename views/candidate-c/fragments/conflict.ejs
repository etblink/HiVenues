<aside id="candidate-inspector" class="cc-studio-inspector" data-open="true" aria-label="Conflict">
  <div class="cc-conflict" role="alert">
    <p class="cc-studio-inspector__eyebrow">Draft changed elsewhere</p>
    <h2>A newer draft exists.</h2>
    <p>This panel was based on an older revision. Nothing was overwritten. Reload the Studio to work from draft r<%= actualRevision %>.</p>
    <a class="cc-button cc-button--ink" href="">Reload current draft</a>
  </div>
</aside>
