<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { graph, pageTitle }) %>
</head>
<body class="cc-task-body">
  <main class="cc-task cc-task--urgent">
    <nav class="cc-task-nav">
      <a class="cc-link" href="/candidate-c/studio/<%= graph.identity.slug %>">Back to Studio</a>
      <span class="cc-draft-status cc-draft-status--live">Live site · <%= release.kind === 'urgent' ? `Version ${release.draftRevision} + urgent update` : `Version ${release.draftRevision}` %></span>
    </nav>
    <p class="cc-kicker">Urgent update</p>
    <h1>Change one thing on the live site now.</h1>
    <p class="cc-task__dek">This starts from what visitors see right now, not from your working version. Only the status you choose here goes live. Everything else on the live site stays exactly as it is, and your unreleased edits stay in Studio, unpublished.</p>

    <% if (noChange) { %>
      <div class="cc-consequence-truth" role="status" data-no-change style="max-width:720px;margin-top:1.5rem">
        <strong>Nothing would change.</strong> That status and note are already what visitors see, so there is no urgent update to publish. Choose a different status or note.
      </div>
    <% } %>
    <% if (notLiveYet) { %>
      <div class="cc-conflict" role="alert" style="max-width:720px;margin-top:1.5rem">
        <strong>That activity is not on the live site yet.</strong> An urgent update can only change something visitors can already see. Release your working version to publish it, then change its status if you need to.
      </div>
    <% } %>

    <% if (activity) { %>
      <form class="cc-setup-form cc-urgent-form" method="post" action="/candidate-c/studio/<%= graph.identity.slug %>/urgent">
        <div class="cc-field">
          <label for="cc-urgent-activity">Which activity?</label>
          <select id="cc-urgent-activity" name="activityId" required>
            <% liveActivities.forEach((item) => { %>
              <option value="<%= item.id %>" <%= item.id === activity.id ? 'selected' : '' %>><%= item.title %> · currently <%= activityLifecycles[item.lifecycle].label.toLowerCase() %></option>
            <% }) %>
          </select>
          <p class="cc-inspector-help">Listed as it appears on the live site. If you renamed it in Studio without releasing, the live title is shown here on purpose.</p>
        </div>
        <fieldset class="cc-field" style="border:0;padding:0;margin:0">
          <legend>New status</legend>
          <div class="cc-choice-grid">
            <% Object.values(activityLifecycles).forEach((option) => { %>
              <label class="cc-choice">
                <input type="radio" name="lifecycle" value="<%= option.id %>" <%= (activity.lifecycle === 'scheduled' ? option.id === 'cancelled' : option.id === activity.lifecycle) ? 'checked' : '' %> required>
                <strong><%= option.label %></strong>
                <small><%= option.id === 'scheduled' ? 'Visitors can RSVP and keep the date.' : option.id === 'cancelled' ? 'Visitors see a clear cancellation and RSVP closes.' : 'Visitors see that it already happened.' %></small>
              </label>
            <% }) %>
          </div>
        </fieldset>
        <div class="cc-field">
          <label for="cc-urgent-note">Short note for visitors <span aria-hidden="true">·</span> optional</label>
          <textarea id="cc-urgent-note" name="statusNote" maxlength="240" rows="2" placeholder="e.g. Tonight is cancelled — tickets are refunded at the door."><%= activity.statusNote || '' %></textarea>
        </div>
        <div class="cc-consequence-truth">
          <strong>What happens next</strong><br>
          You will review exactly what changes before anything goes live. Publishing creates a new immutable website version in this HiVenues reference. It does not broadcast to Hive, request a signature, move value, upload media, mutate a provider, deploy production, or touch DNS.
        </div>
        <div class="cc-inspector-actions">
          <button class="cc-button cc-button--ink" type="submit">Review the change</button>
          <a class="cc-link" href="/candidate-c/studio/<%= graph.identity.slug %>/release">Release the whole working version instead</a>
        </div>
      </form>
    <% } else { %>
      <p class="cc-task__dek">There are no activities on the live site to update.</p>
    <% } %>
  </main>
</body>
</html>
