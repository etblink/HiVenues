<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { graph, pageTitle }) %>
</head>
<body class="cc-task-body">
<%
  const v = typeof values === 'object' && values ? values : {};
  const selectedAuthors = new Set(Array.isArray(v.authorProfileIds) ? v.authorProfileIds : (v.authorProfileIds ? [v.authorProfileIds] : []));
  const selectedMedia = new Set(Array.isArray(v.mediaIds) ? v.mediaIds : (v.mediaIds ? [v.mediaIds] : []));
  const action = story
    ? `/candidate-c/studio/${graph.identity.slug}/territory-content/story/${story.id}`
    : `/candidate-c/studio/${graph.identity.slug}/territory-content/story/new`;
%>
  <main class="cc-task">
    <nav class="cc-task-nav">
      <a class="cc-link" href="/candidate-c/studio/<%= graph.identity.slug %>/territory-content">Back to territory content</a>
      <span class="cc-draft-status">Working Version <%= revision %></span>
    </nav>
    <p class="cc-kicker">Territory · Stories · <%= story ? 'Edit' : 'Add' %></p>
    <h1><%= story ? 'Edit this story.' : 'Add a story to the host.' %></h1>
    <p class="cc-task__dek">This is visitor-facing host content, not an internal design note. Saving changes only Working; the public Release remains unchanged until Release.</p>

    <% if (errors.length) { %><section class="cc-conflict" role="alert"><strong>Check this story.</strong><ul><% errors.forEach((error) => { %><li><%= error.path %>: <%= error.message %></li><% }) %></ul></section><% } %>

    <form class="cc-setup-form" method="post" action="<%= action %>">
      <input type="hidden" name="expectedRevision" value="<%= revision %>">
      <input type="hidden" name="expectedDraftDigest" value="<%= draftDigest %>">
      <div class="cc-field"><label for="cc-story-kind">Story type</label><select id="cc-story-kind" name="kind"><% storyKinds.forEach((kind) => { %><option value="<%= kind.id %>" <%= (v.kind || 'update') === kind.id ? 'selected' : '' %>><%= kind.label %> — <%= kind.help %></option><% }) %></select></div>
      <div class="cc-field"><label for="cc-story-title">Title</label><input id="cc-story-title" name="title" maxlength="160" required value="<%= v.title ?? '' %>"><% if (story) { %><small>Stable public URL: <code><%= story.slug %></code></small><% } else { %><small>A stable URL is created from the title when you add the story.</small><% } %></div>
      <div class="cc-field"><label for="cc-story-dek">Short summary <span aria-hidden="true">·</span> optional</label><textarea id="cc-story-dek" name="dek" maxlength="320"><%= v.dek ?? '' %></textarea></div>
      <div class="cc-field"><label for="cc-story-body">Story</label><textarea id="cc-story-body" name="body" maxlength="16000" required><%= v.body ?? '' %></textarea></div>
      <div class="cc-field"><label for="cc-story-published">Display date/time <span aria-hidden="true">·</span> optional</label><input id="cc-story-published" type="datetime-local" name="publishedLocal" value="<%= v.publishedLocal ?? '' %>"><small>Interpreted in <%= graph.identity.timezone %>. Leave blank if the host does not want a publication time shown.</small></div>

      <fieldset class="cc-field"><legend>Credit people <span aria-hidden="true">·</span> optional</legend>
        <% if (graph.people.length) { graph.people.forEach((profile) => { %>
          <label><input type="checkbox" name="authorProfileIds" value="<%= profile.id %>" <%= selectedAuthors.has(profile.id) ? 'checked' : '' %>> <%= profile.displayName %><% if (profile.role) { %> — <%= profile.role %><% } %></label>
        <% }) } else { %><p>Add a person profile first if this story should carry a byline.</p><% } %>
      </fieldset>

      <fieldset class="cc-field"><legend>Story media <span aria-hidden="true">·</span> optional</legend>
        <% graph.media.forEach((media) => { %><label><input type="checkbox" name="mediaIds" value="<%= media.id %>" <%= selectedMedia.has(media.id) ? 'checked' : '' %>> <%= media.alt %> <small>(<%= media.kind %>)</small></label><% }) %>
      </fieldset>

      <button class="cc-button cc-button--ink" type="submit"><%= story ? 'Save story to Working' : 'Add story to Working' %></button>
    </form>

    <% if (story) { %>
      <form method="post" action="/candidate-c/studio/<%= graph.identity.slug %>/territory-content/story/<%= story.id %>/delete">
        <input type="hidden" name="expectedRevision" value="<%= revision %>">
        <input type="hidden" name="expectedDraftDigest" value="<%= draftDigest %>">
        <button class="cc-button cc-button--quiet" type="submit">Delete story from Working</button>
      </form>
    <% } %>
  </main>
</body>
</html>
