<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { graph, pageTitle }) %>
</head>
<body class="cc-task-body">
  <main class="cc-task">
    <nav class="cc-task-nav">
      <a class="cc-link" href="/candidate-c/studio/<%= graph.identity.slug %>">Back to Studio</a>
      <span class="cc-draft-status">Version <%= revision %></span>
    </nav>
    <p class="cc-kicker">Review release</p>
    <h1>Choose what becomes the live website.</h1>
    <p class="cc-task__dek">Version <%= revision %> is your current working version. Releasing it creates one immutable website version and makes that version visitor-facing here. It does not broadcast to Hive, request a signature, move value, upload media, mutate a provider, deploy production, or touch DNS.</p>

    <div class="cc-review-grid">
      <section class="cc-review-card">
        <p class="cc-kicker">Working version</p>
        <h2>Version <%= revision %> · <%= family.label %></h2>
        <p><strong><%= graph.facts.tagline %></strong></p>
        <p><%= activities.length %> Activity · <%= graph.offers.length %> Offer · <%= graph.media.length %> Media asset</p>
        <details>
          <summary>Technical details</summary>
          <p>Content digest <code><%= draftDigest %></code></p>
        </details>
      </section>
      <section class="cc-review-card">
        <p class="cc-kicker">Currently live</p>
        <h2><%= release ? `Version ${release.draftRevision}` : 'No release' %></h2>
        <% if (release) { %>
          <p><%= release.snapshot.facts.tagline %></p>
          <details>
            <summary>Technical details</summary>
            <p>Release <code><%= release.id %></code></p>
            <p>Content digest <code><%= release.digest %></code></p>
          </details>
        <% } %>
      </section>
    </div>

    <section class="cc-consequence-card" style="margin-top:1.2rem">
      <h2>Website consequence</h2>
      <div class="cc-consequence-truth">Create one immutable website release from working version <%= revision %> and make it the visitor-facing version in this HiVenues reference. No Hive, signing, payment, media-provider, deployment, or DNS action will be triggered.</div>
      <form method="post" action="/candidate-c/studio/<%= graph.identity.slug %>/release" style="margin-top:1rem">
        <input type="hidden" name="expectedRevision" value="<%= revision %>">
        <input type="hidden" name="expectedDraftDigest" value="<%= draftDigest %>">
        <button class="cc-button cc-button--ink" type="submit">Publish website release</button>
      </form>
    </section>

    <section style="margin-top:3rem">
      <p class="cc-kicker">History</p>
      <h2>Earlier website versions</h2>
      <div class="cc-release-list">
        <% releases.slice().reverse().forEach((item) => { %>
          <article class="cc-release-row">
            <div>
              <strong>Version <%= item.draftRevision %> <%= item.id === liveReleaseId ? '· LIVE' : '' %></strong>
              <details>
                <summary>Technical details</summary>
                <p>Release <code><%= item.id %></code></p>
                <p>Content digest <code><%= item.digest %></code></p>
              </details>
            </div>
            <form method="post" action="/candidate-c/studio/<%= graph.identity.slug %>/releases/<%= item.id %>/restore">
              <input type="hidden" name="expectedRevision" value="<%= revision %>">
              <input type="hidden" name="expectedDraftDigest" value="<%= draftDigest %>">
              <button class="cc-button" type="submit">Use as working version</button>
            </form>
          </article>
        <% }) %>
      </div>
    </section>
  </main>
</body>
</html>
