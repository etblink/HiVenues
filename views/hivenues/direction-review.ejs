<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { graph: current.graph, pageTitle }) %>
</head>
<body class="cc-task-body">
  <main class="cc-task">
    <nav class="cc-task-nav">
      <a class="cc-link" href="/hivenues/studio/<%= current.graph.identity.slug %>/direction">Cancel proposal</a>
      <span class="cc-draft-status">Based on Working Version <%= proposal.baseRevision %></span>
    </nav>
    <p class="cc-kicker">Direction · review</p>
    <h1>Same place. Different composition.</h1>
    <p class="cc-task__dek">Only the structural Direction changes here. Your name, visitor copy, Activities, Offers, Media and visit facts stay intact unless you edit them separately.</p>

    <div class="cc-review-grid">
      <section class="cc-review-card">
        <p class="cc-kicker">Current · <%= current.family.label %></p>
        <div class="cc-direction-preview">
          <% if (current.family.id === 'poster') { %>
            <%- include('compositions/poster-canvas', { graph: current.graph, media: current.media, heroMedia: current.heroMedia, logoMedia: current.logoMedia, contact: current.contact, primaryActivity: current.primaryActivity, oob: false }) %>
          <% } else if (current.family.id === 'editorial') { %>
            <%- include('compositions/editorial-canvas', { graph: current.graph, media: current.media, heroMedia: current.heroMedia, logoMedia: current.logoMedia, contact: current.contact, primaryActivity: current.primaryActivity, oob: false }) %>
          <% } else { %>
            <%- include('compositions/hospitality-canvas', { graph: current.graph, media: current.media, heroMedia: current.heroMedia, logoMedia: current.logoMedia, contact: current.contact, primaryActivity: current.primaryActivity, oob: false }) %>
          <% } %>
        </div>
      </section>
      <section class="cc-review-card">
        <p class="cc-kicker">Proposed · <%= proposed.family.label %></p>
        <div class="cc-direction-preview">
          <% if (proposed.family.id === 'poster') { %>
            <%- include('compositions/poster-canvas', { graph: proposed.graph, media: proposed.media, heroMedia: proposed.heroMedia, logoMedia: proposed.logoMedia, contact: proposed.contact, primaryActivity: proposed.primaryActivity, oob: false }) %>
          <% } else if (proposed.family.id === 'editorial') { %>
            <%- include('compositions/editorial-canvas', { graph: proposed.graph, media: proposed.media, heroMedia: proposed.heroMedia, logoMedia: proposed.logoMedia, contact: proposed.contact, primaryActivity: proposed.primaryActivity, oob: false }) %>
          <% } else { %>
            <%- include('compositions/hospitality-canvas', { graph: proposed.graph, media: proposed.media, heroMedia: proposed.heroMedia, logoMedia: proposed.logoMedia, contact: proposed.contact, primaryActivity: proposed.primaryActivity, oob: false }) %>
          <% } %>
        </div>
      </section>
    </div>

    <section class="cc-review-card" style="margin-top:1.2rem">
      <h2>Your authored content stays intact</h2>
      <p>HiVenues keeps the same canonical host content while changing only the composition family shown above.</p>
      <p><strong>Direction:</strong> <%= current.family.label %> → <%= proposed.family.label %></p>
      <form method="post" action="/hivenues/studio/<%= current.graph.identity.slug %>/direction/<%= proposal.id %>/apply">
        <input type="hidden" name="expectedRevision" value="<%= current.revision %>">
        <input type="hidden" name="expectedDraftDigest" value="<%= current.draftDigest %>">
        <button class="cc-button cc-button--ink" type="submit">Apply direction to draft</button>
      </form>
    </section>
  </main>
</body>
</html>
