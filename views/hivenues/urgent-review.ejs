<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { graph, pageTitle }) %>
</head>
<body class="cc-task-body">
  <main class="cc-task cc-task--urgent" data-urgent-operation="<%= operation.id %>" data-urgent-state="<%= operation.state %>">
    <nav class="cc-task-nav">
      <a class="cc-link" href="/hivenues/studio/<%= graph.identity.slug %>">Back to Studio</a>
      <span class="cc-draft-status cc-draft-status--live">Latest Website Release · <%= release ? (release.kind === 'urgent' ? `Version ${release.draftRevision} + urgent update` : `Version ${release.draftRevision}`) : 'No Release' %></span>
    </nav>
    <p class="cc-kicker">Urgent update · review</p>
    <h1><%= operation.change.lifecycle === 'cancelled' ? 'Create a cancellation Website Release.' : operation.change.lifecycle === 'completed' ? 'Mark it as already happened.' : 'Put it back on.' %></h1>
    <p class="cc-task__dek">
      Starting point: the latest Website Release. One thing changes; everything it depends on stays unchanged.
      Your other Working edits remain unreleased, and an external public deployment remains unchanged until you
      explicitly update it.
    </p>

    <% if (failure) { %>
      <div class="cc-conflict" role="alert" style="max-width:760px;margin-top:1.5rem">
        <p class="cc-studio-inspector__eyebrow">No Website Release was created</p>
        <% if (failure.reason === 'STALE_LIVE_RELEASE') { %>
          <h2>The latest Website Release changed while you were reviewing.</h2>
          <p>This review was prepared from an earlier Website Release. Nothing was overwritten. Start the urgent update again from the current Website Release.</p>
          <a class="cc-button cc-button--ink" href="/hivenues/studio/<%= graph.identity.slug %>/urgent?activity=<%= operation.change.activityId %>">Start again from the latest Release</a>
        <% } else if (failure.reason === 'URGENT_ALREADY_RELEASED') { %>
          <h2>This urgent update has already been released.</h2>
          <p>This urgent update can create only one Website Release. The latest Website Release already contains it.</p>
          <a class="cc-button cc-button--ink" href="/hivenues/studio/<%= graph.identity.slug %>">Back to Studio</a>
        <% } else if (failure.reason === 'URGENT_NO_CHANGE') { %>
          <h2>Nothing would change in the latest Website Release.</h2>
          <p>The latest Website Release already shows this status and note, so there is no urgent Website Release to create.</p>
          <a class="cc-button cc-button--ink" href="/hivenues/studio/<%= graph.identity.slug %>/urgent?activity=<%= operation.change.activityId %>">Choose a different change</a>
        <% } else if (failure.reason === 'URGENT_PROVENANCE_MISMATCH' || failure.reason === 'URGENT_CLOSURE_OPEN') { %>
          <h2>This review could not be verified against the latest Website Release.</h2>
          <p>The prepared review no longer re-derives exactly from the latest Website Release. No Website Release was created. Start again so it is rebuilt from the latest Website Release.</p>
          <a class="cc-button cc-button--ink" href="/hivenues/studio/<%= graph.identity.slug %>/urgent?activity=<%= operation.change.activityId %>">Start again from the latest Release</a>
        <% } else { %>
          <h2>A newer working version exists.</h2>
          <p>Your working version changed elsewhere since this page opened. Nothing was overwritten. Reload to review against the current working version <%= failure.actualRevision %>.</p>
          <a class="cc-button cc-button--ink" href="">Reload latest version</a>
        <% } %>
      </div>
    <% } else if (operation.state === 'released') { %>
      <div class="cc-consequence-truth" style="max-width:760px;margin-top:1.5rem">
        <strong>Website Release already created.</strong> This urgent update created Website Release <code><%= operation.releaseId %></code>. It cannot create another Release.
      </div>
    <% } else if (!provenanceVerified) { %>
      <div class="cc-conflict" role="alert" style="max-width:760px;margin-top:1.5rem">
        <strong>This review could not be verified against the latest Website Release.</strong> No Website Release was created. Start again so the review is rebuilt from the latest Website Release.
        <div style="margin-top:.8rem"><a class="cc-button cc-button--ink" href="/hivenues/studio/<%= graph.identity.slug %>/urgent?activity=<%= operation.change.activityId %>">Start again from the latest Release</a></div>
      </div>
    <% } else if (!baseIsLive) { %>
      <div class="cc-conflict" role="alert" style="max-width:760px;margin-top:1.5rem">
        <strong>The latest Website Release changed since this review was prepared.</strong> Start again so the review matches the current Website Release.
        <div style="margin-top:.8rem"><a class="cc-button cc-button--ink" href="/hivenues/studio/<%= graph.identity.slug %>/urgent?activity=<%= operation.change.activityId %>">Start again from the latest Release</a></div>
      </div>
    <% } %>

    <div class="cc-review-grid cc-review-grid--urgent">
      <section class="cc-review-card" aria-labelledby="cc-urgent-changes">
        <p class="cc-kicker">What changes</p>
        <h2 id="cc-urgent-changes"><%= liveActivity ? liveActivity.title : operation.change.activityId %></h2>
        <table class="cc-diff-table" data-urgent-changed>
          <thead><tr><th scope="col">Detail</th><th scope="col">Latest Release</th><th scope="col">After urgent Release</th></tr></thead>
          <tbody>
            <% changedRows.forEach((row) => { %>
              <tr data-path="<%= row.path %>"><th scope="row"><%= row.field %></th><td><%= row.before %></td><td><strong><%= row.after %></strong></td></tr>
            <% }) %>
          </tbody>
        </table>
        <p class="cc-inspector-help">Visitors will see the status on the home page and the activity page. RSVP closes when an activity is cancelled or already happened, and the downloadable calendar entry carries the same status.</p>
      </section>

      <section class="cc-review-card" aria-labelledby="cc-urgent-retained">
        <p class="cc-kicker">Stays in the Website Release, unchanged</p>
        <h2 id="cc-urgent-retained">Everything this depends on</h2>
        <ul class="cc-preserved-list" data-urgent-retained>
          <% retainedRows.forEach((row) => { %>
            <li data-path="<%= row.path %>"><%= row.group %> · <%= row.item %><%= row.field ? ` · ${row.field}` : '' %></li>
          <% }) %>
        </ul>
        <details>
          <summary>Technical details</summary>
          <p>Base release <code><%= operation.baseReleaseId %></code></p>
          <p>Base digest <code><%= operation.baseDigest %></code></p>
          <% if (closureProof) { %>
            <p>Result digest <code><%= closureProof.resultDigest %></code></p>
            <p>Closure proof: <code data-urgent-closed="<%= closureProof.closed %>"><%= closureProof.closed ? 'closed' : 'OPEN' %></code> · exact changes <%= closureProof.actualChanged.length %> · unexpected changes <%= closureProof.unexpectedChanges.length %> · retained mismatches <%= closureProof.retainedMismatch.length %> · re-derived from the base release at review time</p>
          <% } %>
        </details>
      </section>
    </div>

    <section class="cc-review-card cc-review-card--unpublished" style="margin-top:1.2rem" aria-labelledby="cc-urgent-unpublished">
      <p class="cc-kicker">Stays in Working, not in this Release</p>
      <h2 id="cc-urgent-unpublished"><%= unpublishedRows.length ? `${unpublishedRows.length} unreleased edit${unpublishedRows.length === 1 ? '' : 's'} in your working version` : 'Your working version has no other unreleased edits' %></h2>
      <% if (unpublishedRows.length) { %>
        <ul class="cc-preserved-list" data-urgent-unpublished>
          <% unpublishedRows.forEach((row) => { %>
            <li data-path="<%= row.path %>"><%= row.group %> · <%= row.item %><%= row.field ? ` · ${row.field}` : '' %></li>
          <% }) %>
        </ul>
        <p class="cc-inspector-help">These remain exactly as you left them in Studio (working version <%= revision %>) and do not enter this urgent Website Release.</p>
      <% } %>
      <% if (draftAlsoEditsTarget) { %>
        <p class="cc-inspector-help"><strong>Note:</strong> your working version also changes this activity’s status. The urgent status will be carried into the working version so the next whole-site Website Release does not undo it; you can change it again in Studio afterwards.</p>
      <% } else { %>
        <p class="cc-inspector-help">The new status is also carried into your working version as its own step, so the next whole-site Website Release does not quietly undo it.</p>
      <% } %>
    </section>

    <% if (operation.state === 'review' && baseIsLive && provenanceVerified && !failure) { %>
      <section class="cc-consequence-card" style="margin-top:1.2rem">
        <h2>Website consequence</h2>
        <div class="cc-consequence-truth">Create one immutable urgent Website Release from the latest Website Release plus this status change. No Hive, signing, payment, media-provider, external deployment, or DNS action will be triggered.</div>
        <form method="post" action="/hivenues/studio/<%= graph.identity.slug %>/urgent/<%= operation.id %>/publish" style="margin-top:1rem">
          <input type="hidden" name="expectedLiveReleaseId" value="<%= operation.baseReleaseId %>">
          <input type="hidden" name="expectedRevision" value="<%= revision %>">
          <input type="hidden" name="expectedDraftDigest" value="<%= draftDigest %>">
          <button class="cc-button cc-button--ink" type="submit">Create urgent Website Release</button>
        </form>
      </section>
    <% } %>
  </main>
</body>
</html>
