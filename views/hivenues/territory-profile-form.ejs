<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { graph, pageTitle }) %>
</head>
<body class="cc-task-body">
<%
  const v = typeof values === 'object' && values ? values : {};
  const action = profile
    ? `/hivenues/studio/${graph.identity.slug}/territory-content/profile/${profile.id}`
    : `/hivenues/studio/${graph.identity.slug}/territory-content/profile/new`;
%>
  <main class="cc-task">
    <nav class="cc-task-nav">
      <a class="cc-link" href="/hivenues/studio/<%= graph.identity.slug %>/territory-content">Back to territory content</a>
      <span class="cc-draft-status">Working Version <%= revision %></span>
    </nav>
    <p class="cc-kicker">Territory · People · <%= profile ? 'Edit' : 'Add' %></p>
    <h1><%= profile ? 'Edit this public profile.' : 'Add a person to the host.' %></h1>
    <p class="cc-task__dek">Publish only an identity and details the host intends visitors to see. Stories can credit this profile without copying the person into a second data model.</p>

    <% if (errors.length) { %><section class="cc-conflict" role="alert"><strong>Check this profile.</strong><ul><% errors.forEach((error) => { %><li><%= error.path %>: <%= error.message %></li><% }) %></ul></section><% } %>

    <form class="cc-setup-form" method="post" action="<%= action %>">
      <input type="hidden" name="expectedRevision" value="<%= revision %>">
      <input type="hidden" name="expectedDraftDigest" value="<%= draftDigest %>">
      <div class="cc-field"><label for="cc-profile-name">Public name</label><input id="cc-profile-name" name="displayName" maxlength="120" required value="<%= v.displayName ?? '' %>"><% if (profile) { %><small>Stable public URL: <code><%= profile.slug %></code></small><% } %></div>
      <div class="cc-field"><label for="cc-profile-role">Role <span aria-hidden="true">·</span> optional</label><input id="cc-profile-role" name="role" maxlength="160" value="<%= v.role ?? '' %>"></div>
      <div class="cc-field"><label for="cc-profile-bio">Bio</label><textarea id="cc-profile-bio" name="bio" maxlength="2000" required><%= v.bio ?? '' %></textarea></div>
      <div class="cc-field"><label for="cc-profile-media">Portrait / identifying media <span aria-hidden="true">·</span> optional</label><select id="cc-profile-media" name="mediaId"><option value="">No profile media</option><% graph.media.forEach((media) => { %><option value="<%= media.id %>" <%= v.mediaId === media.id ? 'selected' : '' %>><%= media.alt %> (<%= media.kind %>)</option><% }) %></select><small>Only media already admitted to this host can be selected.</small></div>

      <fieldset class="cc-field"><legend>Public links <span aria-hidden="true">·</span> optional</legend>
        <% linkRows.forEach((link, index) => { %>
          <div class="cc-field"><label for="cc-profile-link-label-<%= index %>">Link <%= index + 1 %> label</label><input id="cc-profile-link-label-<%= index %>" name="linkLabel" maxlength="80" value="<%= link.label %>"></div>
          <div class="cc-field"><label for="cc-profile-link-url-<%= index %>">Link <%= index + 1 %> URL</label><input id="cc-profile-link-url-<%= index %>" name="linkUrl" type="url" value="<%= link.url %>" placeholder="https://"></div>
        <% }) %>
        <p><small>Two rows are shown by default. Existing profiles keep all saved link rows; this authoring slice accepts up to 12.</small></p>
      </fieldset>

      <button class="cc-button cc-button--ink" type="submit"><%= profile ? 'Save profile to Working' : 'Add person to Working' %></button>
    </form>

    <% if (profile) { %>
      <form method="post" action="/hivenues/studio/<%= graph.identity.slug %>/territory-content/profile/<%= profile.id %>/delete">
        <input type="hidden" name="expectedRevision" value="<%= revision %>">
        <input type="hidden" name="expectedDraftDigest" value="<%= draftDigest %>">
        <button class="cc-button cc-button--quiet" type="submit">Delete profile from Working</button>
        <p><small>If a story credits this profile, remove that credit first. HiVenues will not orphan the story silently.</small></p>
      </form>
    <% } %>
  </main>
</body>
</html>
