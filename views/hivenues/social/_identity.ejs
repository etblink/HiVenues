<%
  const identityAvailable = Boolean(hivenuesIdentityAvailable);
  const identity = hivenuesIdentity || null;
  const initialState = identity
    ? 'verified'
    : (identityAvailable ? 'not-identified' : 'provider-unavailable');
  const continueHref = typeof identityContinueHref === 'string' && identityContinueHref
    ? identityContinueHref
    : `/hivenues/${encodeURIComponent(graph.identity.slug)}`;
  const createTitle = identityLabels.createTitle || 'Create an account without giving HiVenues your keys';
  const createBody = identityLabels.createBody || 'The official Hive signup directory lets you choose among current ecosystem account-creation providers. Account creation happens outside HiVenues.';
  const laterTitle = identityLabels.laterTitle || 'Keep using this host without connecting Hive';
  const laterBody = identityLabels.laterBody || 'Public browsing stays available. Connect only when a participation action actually needs your identity.';
  const laterAction = identityLabels.laterAction || 'Continue without Hive';
%>
<section
  id="identity"
  class="cc-identity"
  data-hivenues-identity
  data-identity-state="<%= initialState %>"
  <% if (identity?.expiresAt) { %>data-identity-expires-at="<%= identity.expiresAt %>"<% } %>
  aria-labelledby="cc-identity-title"
>
  <div class="cc-identity__intro">
    <p class="cc-kicker"><%= identityLabels.kicker %></p>
    <h2 id="cc-identity-title"><%= identityLabels.title %></h2>
    <p><%= identityLabels.body %></p>
  </div>

  <% if (!identityAvailable) { %>
    <div class="cc-identity__state cc-identity__state--unavailable">
      <strong><%= identityLabels.unavailableTitle %></strong>
      <p data-identity-status role="status">Identity proof is temporarily unavailable. You can keep browsing this public community without signing in.</p>
    </div>
  <% } else if (identity) { %>
    <div class="cc-identity__verified">
      <div>
        <span><%= identityLabels.verifiedLabel %></span>
        <strong>@<%= identity.account %></strong>
      </div>
      <p data-identity-status role="status">
        HiVenues verified control of this Hive account. This identity session does not authorize a post, vote, follow, payment, or other Hive transaction.
      </p>
      <div class="cc-identity__actions">
        <button type="button" data-identity-disconnect><%= identityLabels.disconnect %></button>
        <button type="button" data-identity-reprove hidden>Prove identity again</button>
      </div>
    </div>
  <% } else { %>
    <div class="cc-identity__onboarding" data-identity-onboarding>
      <section class="cc-identity__path cc-identity__path--existing" data-identity-path="existing" aria-labelledby="cc-identity-existing-title">
        <p class="cc-identity__path-kicker">Already on Hive</p>
        <h3 id="cc-identity-existing-title">Connect an existing Hive account</h3>
        <form class="cc-identity__form" data-identity-form>
          <label for="cc-identity-account"><%= identityLabels.accountLabel %></label>
          <div class="cc-identity__account-row">
            <span aria-hidden="true">@</span>
            <input
              id="cc-identity-account"
              name="account"
              data-identity-account
              inputmode="text"
              autocomplete="username"
              autocapitalize="none"
              spellcheck="false"
              maxlength="16"
              placeholder="<%= identityLabels.placeholder %>"
            >
            <button type="submit" data-identity-submit disabled>Review account</button>
          </div>

          <div class="cc-identity__account-review" data-identity-account-review hidden>
            <img data-identity-review-avatar alt="" hidden>
            <div>
              <span data-identity-review-name></span>
              <strong>@<span data-identity-review-account></span></strong>
            </div>
            <button type="button" data-identity-verify><%= identityLabels.action %></button>
          </div>

          <p class="cc-identity__truth" data-identity-proof-boundary>
            Public account details are reviewed before any wallet request. Wallet verification then proves control with a fresh identity message only; HiVenues never receives your private key.
          </p>
          <p class="cc-identity__status" data-identity-status role="status" aria-live="polite"><%= identityLabels.ready %></p>
        </form>
      </section>

      <section class="cc-identity__path cc-identity__path--create" data-identity-path="create" aria-labelledby="cc-identity-create-title">
        <p class="cc-identity__path-kicker">New to Hive</p>
        <h3 id="cc-identity-create-title"><%= createTitle %></h3>
        <p><%= createBody %></p>
        <a
          class="cc-identity__path-action"
          data-identity-create-account
          href="https://signup.hive.io/"
          target="_blank"
          rel="noopener noreferrer"
        >Open Hive account options</a>
        <p class="cc-identity__truth" data-identity-recovery-boundary>Save the credentials and recovery material supplied by the provider you choose. Hive does not have an ordinary centralized password reset. When your account is ready, return here and connect it above.</p>
      </section>

      <section class="cc-identity__path cc-identity__path--later" data-identity-path="later" aria-labelledby="cc-identity-later-title">
        <p class="cc-identity__path-kicker">Not now</p>
        <h3 id="cc-identity-later-title"><%= laterTitle %></h3>
        <p><%= laterBody %></p>
        <a
          class="cc-identity__path-action"
          data-identity-not-now
          href="<%= continueHref %>"
        ><%= laterAction %></a>
      </section>
    </div>
  <% } %>

  <noscript><p class="cc-identity__status">JavaScript is required only for wallet-based identity proof. Public browsing remains available.</p></noscript>
</section>
