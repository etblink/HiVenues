<%
  const resourceSnapshotTime = resourceState?.displayedAt
    ? formatCommunityTime(resourceState.displayedAt, graph.identity.timezone)
    : null;
%>
<% if (resourceState?.visible) { %>
  <section class="cc-resource-state cc-resource-state--<%= graph.presentation.compositionFamily %>" aria-labelledby="cc-resource-state-title">
    <header class="cc-resource-state__head">
      <p class="cc-kicker"><%= resourceLabels.kicker %></p>
      <h2 id="cc-resource-state-title"><%= resourceLabels.title %></h2>
      <p><%= resourceLabels.body %></p>
    </header>

    <% if (resourceState.status === 'ready') { %>
      <div class="cc-resource-state__grid">
        <section class="cc-resource-state__card" aria-labelledby="cc-voting-power-title">
          <p class="cc-resource-state__metaphor"><%= resourceLabels.voting %></p>
          <h3 id="cc-voting-power-title">Voting strength</h3>
          <strong><%= resourceState.votingPowerPercent.toFixed(1) %>%</strong>
          <meter min="0" max="100" value="<%= resourceState.votingPowerPercent %>"><%= resourceState.votingPowerPercent.toFixed(1) %>%</meter>
          <small>Hive protocol: Voting power</small>
        </section>

        <section class="cc-resource-state__card" aria-labelledby="cc-rc-title">
          <p class="cc-resource-state__metaphor"><%= resourceLabels.capacity %></p>
          <h3 id="cc-rc-title">Activity capacity</h3>
          <strong><%= resourceState.resourceCreditsPercent.toFixed(1) %>%</strong>
          <meter min="0" max="100" value="<%= resourceState.resourceCreditsPercent %>"><%= resourceState.resourceCreditsPercent.toFixed(1) %>%</meter>
          <small>Hive protocol: Resource Credits (RC)</small>
        </section>

        <section class="cc-resource-state__card cc-resource-state__card--basis" aria-labelledby="cc-hp-title">
          <p class="cc-resource-state__metaphor"><%= resourceLabels.basis %></p>
          <h3 id="cc-hp-title">Hive Power basis</h3>
          <strong><%= resourceState.hivePower.toFixed(3) %> HP</strong>
          <small>Public Hive account stake used in participation calculations.</small>
        </section>
      </div>

      <section class="cc-resource-state__rewards" aria-labelledby="cc-rewards-title">
        <div>
          <p class="cc-kicker"><%= resourceLabels.rewards %></p>
          <h3 id="cc-rewards-title">Claimable rewards</h3>
        </div>
        <% if (resourceState.hasClaimableRewards) { %>
          <dl>
            <div><dt>HIVE</dt><dd><%= resourceState.rewards.hive.toFixed(3) %></dd></div>
            <div><dt>HBD</dt><dd><%= resourceState.rewards.hbd.toFixed(3) %></dd></div>
            <div><dt>Hive Power</dt><dd><%= resourceState.rewards.hivePower.toFixed(3) %></dd></div>
          </dl>
          <details>
            <summary>Protocol reward detail</summary>
            <p><%= resourceState.rewards.vestingShares.toFixed(6) %> VESTS are currently represented in the Hive Power reward figure above.</p>
          </details>
          <% if (claimRewardsEndpoint) { %>
            <div
              class="cc-reward-claim"
              data-hivenues-reward-claim
              data-reward-url="<%= claimRewardsEndpoint %>"
              data-reward-actor="<%= resourceState.account %>"
              data-reward-state="ready"
            >
              <div class="cc-reward-claim__action">
                <div>
                  <p class="cc-resource-state__metaphor"><%= resourceLabels.claimKicker %></p>
                  <p>Claiming moves the exact current pending rewards into your own Hive account. It does not send them to another account.</p>
                </div>
                <button type="button" data-reward-submit><%= resourceLabels.claimAction %></button>
              </div>
              <p class="cc-reward-claim__status" data-reward-status role="status" aria-live="polite">Review the exact current rewards before your wallet opens.</p>

              <dialog class="cc-reward-review" data-reward-review aria-labelledby="cc-reward-review-title">
                <form method="dialog">
                  <p class="cc-kicker">Before your wallet opens</p>
                  <h2 id="cc-reward-review-title">Review the exact Hive reward claim</h2>
                  <p data-reward-review-consequence></p>
                  <dl>
                    <div><dt>Verified account</dt><dd data-reward-review-account></dd></div>
                    <div><dt>Hive mechanic</dt><dd>claim_reward_balance</dd></div>
                    <div><dt>Pending HIVE</dt><dd data-reward-review-hive></dd></div>
                    <div><dt>Pending HBD</dt><dd data-reward-review-hbd></dd></div>
                    <div><dt>Pending vesting reward</dt><dd data-reward-review-vests></dd></div>
                    <div><dt>Authority</dt><dd data-reward-review-authority></dd></div>
                  </dl>
                  <p>These exact current pending rewards will be claimed into the same Hive account. New rewards that arrive later are not part of this reviewed operation.</p>
                  <details>
                    <summary>Technical operation details</summary>
                    <p>Fingerprint: <code data-reward-review-fingerprint></code></p>
                    <pre data-reward-review-operations></pre>
                  </details>
                  <div class="cc-reward-review__actions">
                    <button type="button" data-reward-confirm>Continue to wallet</button>
                    <button type="button" data-reward-cancel>Cancel</button>
                  </div>
                </form>
              </dialog>
            </div>
          <% } %>
        <% } else { %>
          <p class="cc-resource-state__empty">No claimable Hive rewards are waiting right now.</p>
        <% } %>
        <p class="cc-resource-state__truth"><% if (claimRewardsEndpoint && resourceState.hasClaimableRewards) { %>The only available change here is claiming these exact pending rewards into your own Hive account. <% } else { %>This resource view is read-only. <% } %>Transfers, payments, RC delegation, power changes, savings and other value actions are not available here.</p>
      </section>

      <p class="cc-resource-state__timestamp">
        Hive snapshot <% if (resourceSnapshotTime) { %><time datetime="<%= resourceState.displayedAt %>"><%= resourceSnapshotTime %></time><% } else { %>time unavailable<% } %>
      </p>
    <% } else { %>
      <div class="cc-social-state cc-social-state--<%= resourceState.status %>" role="status">
        <h3>Your Hive participation state is temporarily unavailable.</h3>
        <p>HiVenues did not guess at voting power, Resource Credits, Hive Power, or rewards.</p>
      </div>
    <% } %>
  </section>
<% } %>
