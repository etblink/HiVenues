<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../_head', { graph, pageTitle }) %>
  <link rel="stylesheet" href="/css/hivenues-social-read.css">
</head>
<body class="cc-public cc-poster cc-social cc-social--poster cc-discussion" style="--cc-accent:<%= graph.presentation.accent %>">
  <header class="cc-poster-nav cc-social-nav">
    <a class="cc-wordmark" href="<%= hostHref %>"><%- include('../_logo', { logoMedia }) %><span><%= graph.identity.displayName %></span></a>
    <nav aria-label="Community">
      <a href="<%= communityHref %>">Board conversation</a>
      <a href="<%= socialHref %>">Updates & people</a>
      <a aria-current="page" href="<%= discussionHref %>">Pinned story</a>
    </nav>
  </header>
  <main class="cc-social-shell cc-social-poster-shell cc-discussion-shell cc-discussion-shell--poster">
    <p class="cc-poster-route"><a href="<%= socialHref %>">← Back to the wall</a></p>
    <%- include('_discussion', {
      graph, discussion, memberHref, contentUpdateEndpoint, contentReplyEndpoint, voteEndpoint, votePresentation, formatCommunityTime,
      discussionLabels: {
        state: 'Wall signal',
        unavailableTitle: 'This story is not available on this wall.',
        unavailableBody: 'HiVenues could not verify it as canonical content in this host community.',
        rootKicker: 'Pinned to the wall',
        updateSummary: 'Revise my public note',
        responsesKicker: 'Written underneath',
        responsesTitle: 'Responses on the wall',
        noResponses: 'No one has written underneath this story yet.',
        replyToResponse: 'Reply underneath this response'
      },
      updateLabels: {
        kicker: 'Revision',
        title: 'Revise this public note',
        body: 'Edit your existing Hive post. The public parent and permlink stay fixed.',
        titleLabel: 'Headline',
        bodyLabel: 'Public body',
        previewKicker: 'Wall preview',
        previewTitleEmpty: 'Your headline will appear here',
        previewBodyEmpty: 'Your public text will appear here.',
        action: 'Review revision',
        truth: 'This will change an existing public Hive post after your wallet approves it.',
        ready: 'Nothing changes while you are editing this draft.'
      },
      replyLabels: {
        kicker: 'Write underneath',
        title: 'Add a response',
        body: 'Compose a public Hive reply to this exact piece of content.',
        titleLabel: '',
        bodyLabel: 'Your response',
        previewKicker: 'Response preview',
        previewTitleEmpty: '',
        previewBodyEmpty: 'Your public response will appear here.',
        action: 'Review response',
        truth: 'The parent is fixed from this wall context and revalidated before your wallet opens.',
        ready: 'Nothing is public until you review and approve it.'
      }
    }) %>
  </main>
  <footer class="cc-poster-footer"><p><%= graph.identity.displayName %></p><p>Public content · wallet-owned publishing</p></footer>
  <script src="/js/keychain-adapter.js" defer></script>
  <script src="/js/hivenues-content.js" defer></script>
  <script src="/js/hivenues-vote.js" defer></script>
</body>
</html>
