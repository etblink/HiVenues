<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../_head', { graph, pageTitle }) %>
  <link rel="stylesheet" href="/css/hivenues-social-read.css">
</head>
<body class="cc-public cc-poster cc-social cc-social--poster" style="--cc-accent:<%= graph.presentation.accent %>">
  <header class="cc-poster-nav cc-social-nav">
    <a class="cc-wordmark" href="<%= hostHref %>"><%- include('../_logo', { logoMedia }) %><span><%= graph.identity.displayName %></span></a>
    <nav aria-label="Community">
      <a href="<%= communityHref %>">Board conversation</a>
      <a aria-current="page" href="<%= socialHref %>">Updates & people</a>
      <a href="<%= hostHref %>">Back to the room</a>
    </nav>
  </header>
  <main class="cc-social-shell cc-social-poster-shell">
    <header class="cc-social-mast cc-social-mast--poster">
      <p class="cc-kicker">What is moving through <%= graph.identity.displayName %></p>
      <h1>Fresh on the wall</h1>
      <p>Quick notes, longer stories, and the people showing up around this place—read from Hive without turning the room into a blockchain dashboard.</p>
    </header>
    <%- include('_hub', {
      graph, hub, participation, hubStateCopy, formatCommunityTime, memberHref, discussionHref, contentPostEndpoint,
      socialOrder: ['threads', 'posts', 'people'],
      identityLabels: {
        kicker: 'Join the room',
        title: 'Put your name to the wall',
        body: 'When you want this place to know who you are, prove control of your Hive account without turning the wall into a wallet dashboard.',
        unavailableTitle: 'Introductions are paused',
        verifiedLabel: 'Here as',
        disconnect: 'Step away',
        accountLabel: 'Your Hive account',
        placeholder: 'your-account',
        action: 'Prove who I am',
        ready: 'Public browsing stays open whether or not you identify yourself.'
      },
      communityParticipationLabels: {
        kicker: 'Room membership',
        title: 'Stay connected to the room',
        body: 'Choose whether this Hive account stays connected to the host-bound community behind this room.',
        identifyTitle: 'Put your name to the wall first',
        identifyAction: 'Prove identity',
        unavailableTitle: 'The room status is unclear',
        currentLabel: 'Hive room status',
        currentYes: 'Connected to this community',
        currentNo: 'Not connected to this community',
        join: 'Join this room',
        leave: 'Leave this room',
        ready: 'Review the exact Hive subscription change before your wallet opens.'
      },
      contentPostLabels: {
        kicker: 'Pin something up',
        title: 'Add a new public note',
        body: 'Compose a new public Hive post for this room without exposing raw blockchain fields.',
        titleLabel: 'Headline',
        bodyLabel: 'What you want to put on the wall',
        previewKicker: 'Wall preview',
        previewTitleEmpty: 'Your headline will appear here',
        previewBodyEmpty: 'Your public note will appear here.',
        action: 'Review public note',
        truth: 'A new public Hive post is created only after exact review and approval in your own wallet.',
        ready: 'Draft freely; nothing is public yet.'
      },
      socialLabels: {
        state: 'Wall signal',
        community: 'The wider room',
        threadsKicker: 'Quick notes',
        threadsTitle: 'New on the wall',
        postsKicker: 'Longer reads',
        postsTitle: 'Stories worth pinning up',
        peopleKicker: 'People around here',
        peopleTitle: 'Faces on the wall',
        peopleBody: 'People appearing in recent public notes, stories, or the community subscriber list.',
        quiet: 'Nothing new has landed on the wall yet.'
      }
    }) %>
  </main>
  <footer class="cc-poster-footer"><p><%= graph.identity.displayName %></p><p>Public reads · wallet-owned participation</p></footer>
  <script src="/js/keychain-adapter.js" defer></script>
  <script src="/js/hivenues-identity.js" defer></script>
  <script src="/js/hivenues-participation.js" defer></script>
  <script src="/js/hivenues-content.js" defer></script>
</body>
</html>
