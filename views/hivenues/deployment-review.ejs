<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { graph, pageTitle }) %>
</head>
<body class="cc-task-body">
  <main class="cc-task" data-deployment-exact-review>
    <%
      const isInitialServerSetup = (
        review.target.currentUsername === review.target.bootstrapUsername
        && !deployment.activeRelease
      );
      const sameWebsiteRelease = Boolean(
        deployment.activeRelease
        && deployment.activeRelease.id === review.release.id
        && deployment.activeRelease.digest === review.release.digest
      );
      const actionHeading = deployment.state === 'deploying'
        ? 'Resume this interrupted deployment safely.'
        : (isInitialServerSetup
          ? 'Set up this server and put the Website Release online.'
          : (sameWebsiteRelease
            ? 'Update the public-site runtime without changing the Website Release.'
            : 'Put this Website Release online.'));
      const actionLead = isInitialServerSetup
        ? 'HiVenues will set up its bounded server runtime, install the exact Website Release, move ongoing management to the restricted deployment account, and verify the result.'
        : (sameWebsiteRelease
          ? 'The Website Release is already the public content. This action updates the qualified HiVenues runtime on the established restricted deployment account and then re-verifies the exact Release.'
          : 'HiVenues will use the already-established restricted deployment account to place this exact Website Release online and verify the resulting runtime and Release.');
      const actionButton = deployment.state === 'deploying'
        ? 'Resume this deployment'
        : (isInitialServerSetup
          ? 'Set up server and put Release online'
          : (sameWebsiteRelease ? 'Update public-site runtime' : 'Update public site'));
    %>
    <nav class="cc-task-nav">
      <a
        class="cc-link"
        href="/hivenues/studio/<%= graph.identity.slug %>/deploy"
      >Back to Deployment</a>
      <span class="cc-draft-status">Public website review</span>
    </nav>

    <p class="cc-kicker">Put website online · consequence review</p>
    <h1><%= actionHeading %></h1>
    <p class="cc-task__dek"><%= actionLead %></p>

    <section class="cc-consequence-card" data-deployment-review-consequences>
      <p class="cc-kicker">What changes</p>
      <h2><%= sameWebsiteRelease ? 'Runtime maintenance; website content stays the same' : 'This Website Release will be put online' %></h2>
      <ul>
        <% if (isInitialServerSetup) { %>
          <li>Set up the bounded HiVenues runtime on this verified server.</li>
          <li>Install this exact Website Release.</li>
          <li>Move ongoing management to the restricted deployment account.</li>
          <li>Read back and verify the exact runtime and Website Release.</li>
        <% } else { %>
          <li>Use the existing restricted HiVenues deployment account.</li>
          <li><%= sameWebsiteRelease ? 'Install the qualified runtime while keeping the current Website Release.' : 'Install this exact Website Release with the qualified runtime.' %></li>
          <li>Restart only the dedicated HiVenues site service as required.</li>
          <li>Read back and verify the exact runtime and Website Release.</li>
        <% } %>
      </ul>
    </section>

    <details class="cc-review-card" style="margin-top:1rem" data-deployment-review-technical>
      <summary>Exact technical details</summary>

      <section data-deployment-review-target>
        <p class="cc-kicker">Verified target</p>
        <h2><code><%= review.target.currentUsername %>@<%= review.target.host %>:<%= review.target.port %></code></h2>
        <p>
          Trusted SSH fingerprint:
          <code data-review-host-fingerprint><%= review.target.trustedHostKeyFingerprint %></code>
        </p>
        <p>
          Verified target:
          <code><%= review.target.verifiedOs %></code>
          ·
          <code><%= review.target.verifiedArchitecture %></code>
        </p>
        <% if (review.target.bootstrapUsername !== review.target.currentUsername) { %>
          <p>
            Original setup account:
            <code><%= review.target.bootstrapUsername %></code>
          </p>
        <% } %>
      </section>

      <section data-deployment-review-release>
        <p class="cc-kicker">Exact immutable Release</p>
        <h2><code data-review-release-id><%= review.release.id %></code></h2>
        <p>Release digest: <code><%= review.release.digest %></code></p>
        <p>Package digest: <code data-review-package-digest><%= review.release.packageDigest %></code></p>
      </section>

      <section data-deployment-review-runtime>
        <p class="cc-kicker">Qualified public runtime</p>
        <h2>Installed Studio provenance → deterministic deployment runtime</h2>
        <p>Source commit: <code data-review-source-sha><%= review.runtime.sourceSha %></code></p>
        <p>Source tree: <code data-review-source-tree><%= review.runtime.sourceTree %></code></p>
        <p>Runtime bundle: <code data-review-runtime-digest><%= review.runtime.bundleDigest %></code></p>
        <p>Node: <code><%= review.runtime.nodeVersion %></code> · Package: <code><%= review.runtime.packageVersion %></code></p>
      </section>

      <section data-deployment-review-raw-consequences>
        <p class="cc-kicker">Raw consequence identifiers</p>
        <ul>
          <% review.consequences.forEach((item) => { %>
            <li><code><%= item %></code></li>
          <% }) %>
        </ul>
      </section>
    </details>

    <section class="cc-review-card" data-deployment-review-held>
      <h2>What this action will not do</h2>
      <ul>
        <% review.held.forEach((item) => { %>
          <li><code><%= item %></code></li>
        <% }) %>
      </ul>
      <p>Working state is not deployed. Hive wallet authority is not used. No customer private key enters this flow.</p>
    </section>

    <form
      method="post"
      action="/hivenues/studio/<%= graph.identity.slug %>/deploy/<%= deployment.id %>/deploy-exact"
      class="cc-consequence-card"
      data-deployment-exact-confirmation
    >
      <input type="hidden" name="reviewDigest" value="<%= review.reviewDigest %>">
      <label>
        <input
          type="checkbox"
          name="confirmation"
          value="deploy-exact-release"
          required
        >
        I reviewed what this action changes, what it leaves unchanged, and the exact technical details available above.
      </label>
      <button class="cc-button cc-button--ink" type="submit" data-confirm-exact-deployment>
        <%= actionButton %>
      </button>
    </form>
  </main>
</body>
</html>
