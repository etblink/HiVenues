<%
  const iconName = String(name || 'spark');
  const iconClass = typeof className === 'string' ? className : '';
%>
<svg class="cc-ui-icon <%= iconClass %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <% if (iconName === 'update') { %>
    <path d="M5 5.5h14v10H9l-4 3v-13Z" />
    <path d="M8 9h8M8 12h5" />
  <% } else if (iconName === 'story') { %>
    <path d="M6 3.5h9l3 3V20H6z" />
    <path d="M15 3.5V7h3M9 11h6M9 14h6M9 17h4" />
  <% } else if (iconName === 'people') { %>
    <circle cx="9" cy="8" r="3" />
    <path d="M3.5 19c.5-3.2 2.4-5 5.5-5s5 1.8 5.5 5" />
    <path d="M15 6.3a2.7 2.7 0 0 1 0 5.3M16 14c2.5.4 4 2 4.5 4.5" />
  <% } else if (iconName === 'gallery') { %>
    <rect x="3.5" y="4" width="17" height="16" rx="2" />
    <circle cx="9" cy="9" r="1.5" />
    <path d="m5.5 17 4.2-4.2 2.8 2.8 2.2-2.2 3.8 3.6" />
  <% } else if (iconName === 'navigation') { %>
    <circle cx="6" cy="6" r="2" />
    <circle cx="18" cy="6" r="2" />
    <circle cx="12" cy="18" r="2" />
    <path d="M8 6h8M7 7.7l4 8M17 7.7l-4 8" />
  <% } else if (iconName === 'preview') { %>
    <path d="M2.8 12s3.2-5.4 9.2-5.4 9.2 5.4 9.2 5.4-3.2 5.4-9.2 5.4S2.8 12 2.8 12Z" />
    <circle cx="12" cy="12" r="2.7" />
  <% } else if (iconName === 'media') { %>
    <path d="M4 5h16v14H4z" />
    <path d="m6.5 16 4-4 2.5 2.5 2-2 2.5 3.5" />
    <circle cx="9" cy="9" r="1.3" />
  <% } else if (iconName === 'add') { %>
    <path d="M12 5v14M5 12h14" />
  <% } else { %>
    <path d="m12 3 1.5 5.5L19 10l-5.5 1.5L12 17l-1.5-5.5L5 10l5.5-1.5L12 3Z" />
  <% } %>
</svg>
