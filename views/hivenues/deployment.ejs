<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { graph, pageTitle }) %>
</head>
<body class="cc-task-body">
  <main class="cc-task" data-deployment-stage1 <%= deploymentAuthorityAvailable ? 'data-deployment-stage2a' : '' %>>
    <nav class="cc-task-nav">
      <a class="cc-link" href="/hivenues/studio/<%= graph.identity.slug %>">Back to Studio</a>
      <span class="cc-draft-status">Working Version <%= revision %></span>
    </nav>

    <p class="cc-kicker">Deployment · qualification boundary</p>
    <h1>Prepare an exact Release and deployment target safely.</h1>
    <p class="cc-task__dek">
      Offline simulation remains available everywhere. Installed Windows HiVenues may also create a protected
      deployment-only SSH authority for provider handoff. Real SSH inspection, server mutation, DNS, TLS,
      payment and public deployment remain unavailable at this stage.
    </p>

    <% if (error) { %>
      <section class="cc-review-card" data-deployment-error>
        <strong>Deployment simulation stopped</strong>
        <p><%= error %></p>
      </section>
    <% } %>

    <% if (!deploymentAvailable) { %>
      <section class="cc-review-card" data-deployment-unavailable>
        <h2>Local deployment simulation is unavailable</h2>
        <p>This runtime was not started with the Stage-1 deployment services.</p>
      </section>
    <% } else { %>
      <section class="cc-review-card" data-deployment-profile>
        <p class="cc-kicker">Target family</p>
        <h2>Offline synthetic target</h2>
        <p>This adapter exists only to qualify the product state machine before real infrastructure authority is admitted.</p>
        <details>
          <summary>Capabilities</summary>
          <p><code><%= deploymentProfile.capabilities.join(', ') %></code></p>
          <p>External effects: <strong><%= deploymentProfile.externalEffects ? 'enabled' : 'disabled' %></strong></p>
        </details>
        <form method="post" action="/hivenues/studio/<%= graph.identity.slug %>/deploy/targets">
          <button class="cc-button cc-button--ink" type="submit" data-create-deployment-target>Add offline deployment target</button>
        </form>
      </section>

      <% if (deploymentAuthorityAvailable) { %>
        <section class="cc-review-card" data-deployment-authority-profile style="margin-top:1.2rem">
          <p class="cc-kicker">Reference server handoff</p>
          <h2>Prepare a protected SSH deployment identity</h2>
          <p>
            HiVenues can generate a deployment-only key locally. The private key is protected by the
            operating system and is not shown here. Only the public key is handed to the server provider.
          </p>
          <form method="post" action="/hivenues/studio/<%= graph.identity.slug %>/deploy/targets/reference-ssh">
            <button class="cc-button" type="submit" data-create-reference-ssh-target>Prepare server target</button>
          </form>
        </section>
      <% } %>

      <% if (!releases.length) { %>
        <section class="cc-review-card" data-deployment-no-release style="margin-top:1.2rem">
          <h2>Create a Release first</h2>
          <p>Deployment can use only an immutable HiVenues Release. Working state cannot be deployed.</p>
          <a class="cc-button" href="/hivenues/studio/<%= graph.identity.slug %>/release">Review and create a Release</a>
        </section>
      <% } %>

      <section style="margin-top:2rem">
        <p class="cc-kicker">Local targets</p>
        <h2>Deployment state</h2>

        <% if (!deployments.length) { %>
          <p data-deployment-empty>No deployment targets yet.</p>
        <% } %>

        <div class="cc-release-list">
          <% deployments.forEach((deployment) => { %>
            <article class="cc-review-card" data-deployment-record="<%= deployment.id %>">
              <div>
                <p class="cc-kicker"><%= deployment.providerKind === 'synthetic-offline' ? 'Synthetic target' : 'Server target' %></p>
                <h3><%= deployment.id %></h3>
                <p>
                  State:
                  <strong data-deployment-state><%= deployment.state %></strong>
                </p>
                <p>Provider: <%= deployment.providerKind %> · <%= deployment.providerProfile %></p>
                <p>Provider state: <%= deployment.providerState %> · Payment state: <%= deployment.paymentState %></p>
                <p>Health: <%= deployment.healthState %> · Rollback: <%= deployment.rollbackState %></p>

                <% if (deployment.authorityPublic) { %>
                  <section class="cc-consequence-card" data-deployment-authority-public>
                    <h4>Deployment public key</h4>
                    <p>
                      This public key may be supplied to the server provider. The protected private key remains
                      local to this HiVenues installation.
                    </p>
                    <label>
                      Public SSH key
                      <textarea
                        rows="5"
                        readonly
                        data-deployment-public-key
                      ><%= deployment.authorityPublic.publicKey %></textarea>
                    </label>
                    <p>Key fingerprint: <code data-deployment-public-key-fingerprint><%= deployment.authorityPublic.publicKeyFingerprint %></code></p>
                    <button
                      class="cc-button"
                      type="button"
                      data-copy-deployment-public-key
                    >Copy public key</button>
                    <span data-copy-deployment-public-key-status role="status" aria-live="polite"></span>
                  </section>
                <% } %>

                <% if (deployment.providerKind === 'ssh-server' && Object.keys(deployment.targetPublicFacts || {}).length) { %>
                  <p data-deployment-server-facts>
                    Server:
                    <code><%= deployment.targetPublicFacts.username %>@<%= deployment.targetPublicFacts.host %>:<%= deployment.targetPublicFacts.port %></code>
                  </p>
                <% } %>

                <% if (deployment.selectedRelease) { %>
                  <p>
                    Selected Release:
                    <code data-selected-release><%= deployment.selectedRelease.id %></code>
                    · <code><%= deployment.selectedRelease.digest %></code>
                  </p>
                <% } %>

                <% if (deployment.package) { %>
                  <p>Prepared package: <code data-package-digest><%= deployment.package.packageDigest %></code></p>
                <% } %>

                <% if (deployment.activeRelease) { %>
                  <p>
                    Synthetic read-back:
                    <code data-active-release><%= deployment.activeRelease.id %></code>
                    · <code><%= deployment.activeRelease.digest %></code>
                  </p>
                <% } %>

                <% if (deployment.previousRelease) { %>
                  <p>Rollback candidate: <code data-previous-release><%= deployment.previousRelease.id %></code></p>
                <% } %>
              </div>

              <% if (deployment.state !== 'disconnected') { %>
                <div style="display:grid;gap:.8rem;margin-top:1rem">
                  <% if (deployment.providerKind === 'ssh-server' && ['target-draft', 'awaiting-provider'].includes(deployment.state)) { %>
                    <form
                      method="post"
                      action="/hivenues/studio/<%= graph.identity.slug %>/deploy/<%= deployment.id %>/connection"
                      data-deployment-server-connection
                    >
                      <label>
                        Server address
                        <input name="host" required autocomplete="off" inputmode="url" placeholder="server.example.com or IP address">
                      </label>
                      <label>
                        SSH port
                        <input name="port" required type="number" min="1" max="65535" value="22">
                      </label>
                      <label>
                        Remote account
                        <input name="username" required autocomplete="off" value="root">
                      </label>
                      <button class="cc-button" type="submit">Save public server details</button>
                    </form>
                  <% } %>

                  <% if (releases.length) { %>
                    <form
                      method="post"
                      action="/hivenues/studio/<%= graph.identity.slug %>/deploy/<%= deployment.id %>/release"
                      data-select-deployment-release
                    >
                      <label>
                        Immutable Release
                        <select name="releaseId" required>
                          <option value="">Choose Release</option>
                          <% releases.slice().reverse().forEach((item) => { %>
                            <option
                              value="<%= item.id %>"
                              <%= deployment.selectedRelease && deployment.selectedRelease.id === item.id ? 'selected' : '' %>
                            >
                              Version <%= item.draftRevision %><%= item.kind === 'urgent' ? ' + urgent update' : '' %> · <%= item.id %>
                            </option>
                          <% }) %>
                        </select>
                      </label>
                      <button class="cc-button" type="submit">Prepare exact Release package</button>
                    </form>
                  <% } %>

                  <% if (deployment.providerKind === 'synthetic-offline' && (deployment.state === 'target-draft' || deployment.state === 'awaiting-provider')) { %>
                    <form method="post" action="/hivenues/studio/<%= graph.identity.slug %>/deploy/<%= deployment.id %>/target-ready">
                      <button class="cc-button" type="submit" data-mark-target-ready>Simulate provider handoff</button>
                    </form>
                  <% } %>

                  <% if (deployment.providerKind === 'synthetic-offline' && (deployment.state === 'target-ready' || deployment.state === 'degraded' || deployment.state === 'unreachable')) { %>
                    <form method="post" action="/hivenues/studio/<%= graph.identity.slug %>/deploy/<%= deployment.id %>/verify">
                      <button class="cc-button" type="submit" data-verify-deployment-target>Verify synthetic target</button>
                    </form>
                  <% } %>

                  <% if (
                    deployment.providerKind === 'synthetic-offline'
                    && deployment.selectedRelease
                    && deployment.package
                    && ['bootstrap-ready', 'healthy', 'rollback-available', 'degraded'].includes(deployment.state)
                  ) { %>
                    <form method="post" action="/hivenues/studio/<%= graph.identity.slug %>/deploy/<%= deployment.id %>/deploy">
                      <button class="cc-button cc-button--ink" type="submit" data-deploy-release>Simulate exact Release deployment</button>
                    </form>
                  <% } %>

                  <% if (deployment.providerKind === 'synthetic-offline' && (deployment.state === 'healthy' || deployment.state === 'rollback-available')) { %>
                    <form method="post" action="/hivenues/studio/<%= graph.identity.slug %>/deploy/<%= deployment.id %>/degrade">
                      <button class="cc-button" type="submit" data-degrade-deployment>Simulate degraded health</button>
                    </form>
                  <% } %>

                  <% if (deployment.providerKind === 'synthetic-offline' && deployment.previousRelease && ['rollback-available', 'healthy', 'degraded'].includes(deployment.state)) { %>
                    <form method="post" action="/hivenues/studio/<%= graph.identity.slug %>/deploy/<%= deployment.id %>/rollback">
                      <button class="cc-button" type="submit" data-rollback-deployment>Simulate rollback</button>
                    </form>
                  <% } %>

                  <% if (deployment.providerKind === 'ssh-server' && deployment.state === 'target-ready') { %>
                    <section class="cc-review-card" data-deployment-ssh-verification-held>
                      <strong>Server details ready for verification</strong>
                      <p>Read-only SSH inspection is the next qualified boundary and is not enabled by this screen yet.</p>
                    </section>
                  <% } %>

                  <form method="post" action="/hivenues/studio/<%= graph.identity.slug %>/deploy/<%= deployment.id %>/disconnect">
                    <button class="cc-button" type="submit" data-disconnect-deployment>Disconnect local target</button>
                  </form>
                </div>
              <% } %>

              <details style="margin-top:1rem">
                <summary>State history</summary>
                <ol>
                  <% deployment.history.forEach((item) => { %>
                    <li><code><%= item.from || 'none' %> → <%= item.to %></code> · <%= item.at %></li>
                  <% }) %>
                </ol>
              </details>
            </article>
          <% }) %>
        </div>
      </section>

      <section class="cc-consequence-card" style="margin-top:2rem" data-deployment-stage1-boundary>
        <h2>Authority boundary</h2>
        <p>
          Synthetic deployment remains local-only. Where protected authority is available, HiVenues may
          generate a deployment-only key and record public server facts, but this stage still performs no
          SSH connection, server mutation, provider write, DNS/TLS mutation, payment or public deployment.
        </p>
      </section>
    <% } %>
  </main>
  <script defer src="/js/hivenues-deployment.js"></script>
</body>
</html>
