<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../_head', { graph, pageTitle }) %>
</head>
<%
  const previewMode = typeof draftPreview !== 'undefined' && draftPreview === true;
  const hostHref = previewMode ? `/hivenues/studio/${encodeURIComponent(graph.identity.slug)}/preview` : `/hivenues/${encodeURIComponent(graph.identity.slug)}`;
  const activityHref = `${hostHref}/activities/${encodeURIComponent(activity.slug)}`;
  const calendarHref = `${activityHref}/calendar.ics`;
  const consequenceHref = previewMode ? `${hostHref}/consequence/applaud_hive` : `/hivenues/${encodeURIComponent(graph.identity.slug)}/consequence/applaud_hive`;
  const rsvpHref = `/hivenues/${encodeURIComponent(graph.identity.slug)}/activities/${encodeURIComponent(activity.slug)}/rsvp`;
%>
<body class="cc-public cc-hospitality cc-activity-page" style="--cc-accent:<%= graph.presentation.accent %>">
  <header class="cc-hospitality-nav cc-hospitality-nav--activity">
    <a class="cc-hospitality-name" href="<%= hostHref %>"><%= graph.identity.displayName %></a>
    <a class="cc-link" href="<%= hostHref %>">Back to <%= graph.identity.displayName %></a>
  </header>

  <main class="cc-hospitality-activity">
    <section class="cc-hospitality-activity__intro">
      <div class="cc-hospitality-activity__copy">
        <p class="cc-kicker">At <%= graph.identity.displayName %></p>
        <h1><%= activity.title %></h1>
        <%- include('../_status', { activity }) %>
        <p class="cc-time"><%= activity.humanTime %></p>
        <p class="cc-hospitality-activity__description"><%= activity.description %></p>
        <dl class="cc-hospitality-activity__facts">
          <div>
            <dt>Where</dt>
            <dd>
              <%= activity.presence.mode === 'online' ? activity.presence.platformLabel : activity.presence.venueName %>
              <% if (activity.presence.mode !== 'online') { %><br><%= activity.presence.address %><% } %>
              <% if (activity.presence.mode === 'hybrid') { %><br><%= activity.presence.platformLabel %><% } %>
            </dd>
          </div>
          <div><dt>Participation</dt><dd><%= graph.intent.participation %></dd></div>
        </dl>
      </div>
      <div class="cc-hospitality-activity__media">
        <%- include('../_art', { media: activity.media, graph }) %>
        <p class="cc-hospitality-caption"><%= activity.media.provenance %></p>
      </div>
    </section>

    <section class="cc-hospitality-rsvp" aria-labelledby="cc-hospitality-rsvp-title">
      <div>
        <p class="cc-kicker"><%= graph.identity.displayName %></p>
        <h2 id="cc-hospitality-rsvp-title">Tell us who to expect.</h2>
        <p>This dogfood runtime records the RSVP locally. It does not create a blockchain transaction, payment, provider reservation, or platform account.</p>
      </div>
      <% if (previewMode) { %>
      <div class="cc-rsvp cc-rsvp--closed" data-draft-preview-action>
        <p><strong>Draft preview.</strong> Visitor RSVP is not active here. Release this working version to make visitor actions available.</p>
      </div>
      <% } else if (activity.open) { %>
      <form class="cc-rsvp" method="post" action="<%= rsvpHref %>" hx-post="<%= rsvpHref %>" hx-target="#cc-rsvp-result" hx-swap="innerHTML">
        <label for="cc-rsvp-name">Name</label>
        <div class="cc-rsvp__row">
          <input id="cc-rsvp-name" name="name" autocomplete="name" maxlength="80" placeholder="Your name">
          <button class="cc-button cc-button--hospitality" type="submit"><%= graph.voice.terms.rsvp_local %></button>
        </div>
        <div id="cc-rsvp-result" aria-live="polite"></div>
        <div class="cc-hospitality-rsvp__links">
          <a class="cc-link" href="<%= calendarHref %>"><%= graph.voice.terms.calendar_ics %></a>
          <a class="cc-link" href="<%= consequenceHref %>"><%= graph.voice.terms.applaud_hive %></a>
        </div>
      </form>
      <% } else { %>
      <div class="cc-rsvp cc-rsvp--closed" data-rsvp-closed>
        <p><strong><%= activity.lifecycle === 'cancelled' ? 'Cancelled' : 'Already happened' %>.</strong> RSVPs are closed for this one.</p>
      </div>
      <div class="cc-hospitality-rsvp__links">
        <a class="cc-link" href="<%= calendarHref %>"><%= graph.voice.terms.calendar_ics %></a>
      </div>
      <% } %>
      <% if (previewMode) { %>
      <div class="cc-hospitality-rsvp__links">
        <a class="cc-link" href="<%= calendarHref %>"><%= graph.voice.terms.calendar_ics %></a>
        <a class="cc-link" href="<%= consequenceHref %>"><%= graph.voice.terms.applaud_hive %></a>
      </div>
      <% } %>
    </section>
  </main>
  <script src="/htmx/htmx.min.js" defer></script>
</body>
</html>
