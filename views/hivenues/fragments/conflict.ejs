<aside id="candidate-inspector" class="cc-studio-inspector" data-open="true" aria-label="Conflict">
  <div class="cc-conflict" role="alert">
    <p class="cc-studio-inspector__eyebrow">This page changed elsewhere</p>
    <h2>A newer version exists.</h2>
    <p>This editor opened before the latest change. Nothing was overwritten. Reload Studio to continue from version <%= actualRevision %>.</p>
    <a class="cc-button cc-button--ink" href="">Reload latest version</a>
  </div>
</aside>
