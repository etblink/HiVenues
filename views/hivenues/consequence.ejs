<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { graph, pageTitle }) %>
</head>
<%
  const previewMode = typeof draftPreview !== 'undefined' && draftPreview === true;
  const hostHref = previewMode ? `/hivenues/studio/${encodeURIComponent(graph.identity.slug)}/preview` : `/hivenues/${encodeURIComponent(graph.identity.slug)}`;
%>
<body class="cc-task-body" style="--cc-accent:<%= graph.presentation.accent %>">
  <main class="cc-task">
    <nav class="cc-task-nav">
      <a class="cc-link" href="<%= hostHref %>">Back to <%= graph.identity.displayName %></a>
      <span class="cc-draft-status">Connection unavailable in this test</span>
    </nav>
    <p class="cc-kicker">What this visitor action means</p>
    <h1><%= term %></h1>
    <p class="cc-task__dek">The host can name participation in its own voice. HiVenues still explains what would actually happen before any consequential action.</p>

    <section class="cc-consequence-card">
      <h2>What this action does</h2>
      <p><%= mechanic.meaning %></p>
      <div class="cc-consequence-truth"><%= disclosure %></div>
      <p><strong>No live action is available here</strong> because the required Hive connection/signing authority is not enabled in this isolated test. Nothing will be signed or broadcast.</p>
      <details>
        <summary>Technical details</summary>
        <dl>
          <dt><strong>Mechanic</strong></dt><dd><code><%= mechanic.id %></code></dd>
          <dt><strong>Consequence class</strong></dt><dd><%= mechanic.consequenceClass %></dd>
          <dt><strong>Moves value</strong></dt><dd><%= mechanic.movesValue ? 'Yes' : 'No' %></dd>
          <dt><strong>Public</strong></dt><dd><%= mechanic.public ? 'Yes' : 'No' %></dd>
          <dt><strong>Connection state</strong></dt><dd><%= graph.bindings.hive.state %></dd>
        </dl>
      </details>
    </section>
  </main>
</body>
</html>
