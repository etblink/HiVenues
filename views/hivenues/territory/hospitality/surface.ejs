<!DOCTYPE html>
<html lang="en"><head><%- include('../../_head', { graph, pageTitle }) %></head>
<body class="cc-public cc-hospitality cc-territory cc-territory--hospitality" style="--cc-accent:<%= graph.presentation.accent %>">
<header class="cc-territory-hospitality__mast"><a class="cc-hospitality-name" href="<%= territory.navigation.find((item) => item.role === 'home')?.path %>"><%- include('../../_logo', { logoMedia }) %><span><%= graph.identity.displayName %></span></a><p><%= graph.facts.presence.label %></p><nav aria-label="Primary"><% territory.navigation.forEach((item) => { %><a href="<%= item.path %>" <%= item.surfaceRole === surface.role ? 'aria-current="page"' : '' %>><%= item.label %></a><% }) %></nav></header>
<main class="cc-territory-hospitality__page">
<header class="cc-territory-hospitality__intro"><p class="cc-kicker"><%= surface.label %></p>
<% if (surface.role === 'activities-index') { %><h1>Gather around the next thing.</h1><p>Upcoming and remembered moments from <%= graph.identity.displayName %>.</p><% } %>
<% if (surface.role === 'offers') { %><h1>From the house.</h1><p><%= graph.intent.participation %></p><% } %>
<% if (surface.role === 'stories-index') { %><h1>Notes worth carrying home.</h1><p><%= graph.facts.summary %></p><% } %>
<% if (surface.role === 'story-detail') { %><h1><%= story.title %></h1><% if (story.dek) { %><p><%= story.dek %></p><% } %><% } %>
<% if (surface.role === 'gallery') { %><h1><%= graph.gallery.title %></h1><p><%= graph.gallery.summary %></p><% } %>
<% if (surface.role === 'people-index') { %><h1>The people at the table.</h1><p>A host is a place made by people, not a list of accounts.</p><% } %>
<% if (surface.role === 'profile-detail') { %><h1><%= profile.displayName %></h1><p><%= profile.role || `Part of ${graph.identity.displayName}` %></p><% } %>
<% if (surface.role === 'about-visit') { %><h1>Come find <%= graph.identity.displayName %>.</h1><p><%= graph.facts.summary %></p><% } %></header>
<% if (surface.role === 'activities-index') { %><section class="cc-territory-hospitality__list"><% activities.forEach((activity)=>{ %><article><div><p class="cc-kicker"><%= activity.status.label %></p><h2><a href="<%= activityPaths[activity.id] %>"><%= activity.title %></a></h2><p><%= activity.humanTime %></p><p><%= activity.description %></p></div><a class="cc-button cc-button--hospitality" href="<%= activityPaths[activity.id] %>"><%= activity.open ? graph.voice.terms.rsvp_local : 'See details' %></a></article><% }) %></section><% } %>
<% if (surface.role === 'offers') { %><section class="cc-territory-hospitality__menu"><% graph.offers.forEach((offer)=>{ %><article><div><p class="cc-kicker"><%= offer.category || 'From the house' %></p><h2><%= offer.title %></h2><p><%= offer.summary %></p></div><% if (offer.price) { %><strong><%= offer.price %></strong><% } %></article><% }) %></section><% } %>
<% if (surface.role === 'stories-index') { %><section class="cc-territory-hospitality__stories"><% stories.forEach((item)=>{ %><article><p class="cc-kicker"><%= item.kind %></p><h2><a href="<%= storyPaths[item.id] %>"><%= item.title %></a></h2><p><%= item.dek || item.body %></p><% if (item.authors.length) { %><small>By <% item.authors.forEach((a,i)=>{ %><a href="<%= profilePaths[a.id] %>"><%= a.displayName %></a><%= i < item.authors.length-1 ? ' · ' : '' %><% }) %></small><% } %></article><% }) %></section><% } %>
<% if (surface.role === 'story-detail') { %><article class="cc-territory-hospitality__story"><% if (story.media[0]) { %><figure><%- include('../../_art',{media:story.media[0],graph}) %><figcaption><%= story.media[0].alt %></figcaption></figure><% } %><div><p class="cc-kicker"><%= story.kind %><% if (story.authors.length) { %> · <% story.authors.forEach((a,i)=>{ %><a href="<%= profilePaths[a.id] %>"><%= a.displayName %></a><%= i < story.authors.length-1 ? ', ' : '' %><% }) %><% } %></p><p class="cc-territory-hospitality__body"><%= story.body %></p></div></article><% } %>
<% if (surface.role === 'gallery') { %><section class="cc-territory-hospitality__gallery"><% galleryMedia.forEach((item)=>{ %><figure><%- include('../../_art',{media:item,graph}) %><figcaption><%= item.alt %></figcaption></figure><% }) %></section><% } %>
<% if (surface.role === 'people-index') { %><section class="cc-territory-hospitality__people"><% people.forEach((person)=>{ %><article><% if (person.media) { %><div><%- include('../../_art',{media:person.media,graph}) %></div><% } %><p class="cc-kicker"><%= person.role || 'Contributor' %></p><h2><a href="<%= profilePaths[person.id] %>"><%= person.displayName %></a></h2><p><%= person.bio %></p></article><% }) %></section><% } %>
<% if (surface.role === 'profile-detail') { %><article class="cc-territory-hospitality__story"><% if (profile.media) { %><figure><%- include('../../_art',{media:profile.media,graph}) %></figure><% } %><div><p class="cc-kicker"><%= profile.role || 'Contributor' %></p><p class="cc-territory-hospitality__body"><%= profile.bio %></p><% profile.links.forEach((link)=>{ %><p><a class="cc-link" href="<%= link.url %>"><%= link.label %></a></p><% }) %></div></article><% } %>
<% if (surface.role === 'about-visit') { %><section class="cc-territory-hospitality__visit"><div><p class="cc-kicker">Why this place</p><p class="cc-territory-hospitality__body"><%= graph.intent.presenceMaterial %></p><p><%= graph.intent.purpose %></p></div><div><p class="cc-kicker"><%= graph.facts.presence.mode === 'online' ? 'Find us online' : 'Come by' %></p><h2><%= graph.facts.presence.label %></h2><% if (graph.facts.presence.address) { %><p><%= graph.facts.presence.address %></p><% } %><p><% if (contact.href) { %><a href="<%= contact.href %>"><%= contact.label %></a><% } else { %><%= contact.label %><% } %></p></div></section><% } %>
</main><footer class="cc-hospitality-footer"><span><%= graph.identity.displayName %></span><span><%= graph.facts.presence.label %></span></footer></body></html>
