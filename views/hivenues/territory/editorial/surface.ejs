<!DOCTYPE html>
<html lang="en"><head><%- include('../../_head', { graph, pageTitle }) %></head>
<body class="cc-public cc-editorial cc-territory cc-territory--editorial" style="--cc-accent:<%= graph.presentation.accent %>">
<header class="cc-territory-editorial__mast"><a class="cc-editorial-name" href="<%= territory.navigation.find((item) => item.role === 'home')?.path %>"><%- include('../../_logo', { logoMedia }) %><span><%= graph.identity.displayName %></span></a><nav aria-label="Primary"><% territory.navigation.forEach((item) => { %><a href="<%= item.path %>" <%= item.surfaceRole === surface.role ? 'aria-current="page"' : '' %>><%= item.label %></a><% }) %></nav></header>
<main class="cc-territory-editorial__page">
<header class="cc-territory-editorial__deck"><p class="cc-editorial-index"><%= surface.role.replaceAll('-', ' / ').toUpperCase() %></p><div>
<% if (surface.role === 'activities-index') { %><h1>Program index</h1><p>Dates, sessions, and what remains in the archive.</p><% } %>
<% if (surface.role === 'offers') { %><h1>Objects & invitations</h1><p><%= graph.intent.participation %></p><% } %>
<% if (surface.role === 'stories-index') { %><h1>Field notes</h1><p><%= graph.facts.summary %></p><% } %>
<% if (surface.role === 'story-detail') { %><h1><%= story.title %></h1><% if (story.dek) { %><p class="cc-territory-editorial__lede"><%= story.dek %></p><% } %><% } %>
<% if (surface.role === 'gallery') { %><h1><%= graph.gallery.title %></h1><p><%= graph.gallery.summary %></p><% } %>
<% if (surface.role === 'people-index') { %><h1>Contributors</h1><p>People are part of the publication grammar, not a detached directory.</p><% } %>
<% if (surface.role === 'profile-detail') { %><h1><%= profile.displayName %></h1><p class="cc-territory-editorial__lede"><%= profile.role || 'Contributor' %></p><% } %>
<% if (surface.role === 'about-visit') { %><h1>About <%= graph.identity.displayName %></h1><p class="cc-territory-editorial__lede"><%= graph.facts.tagline %></p><% } %>
</div></header>
<% if (surface.role === 'activities-index') { %><section class="cc-territory-editorial__index"><% activities.forEach((activity,index)=>{ %><article><p class="cc-editorial-index"><%= String(index+1).padStart(2,'0') %></p><div><p class="cc-kicker"><%= activity.status.label %> · <%= activity.humanTime %></p><h2><a href="<%= activityPaths[activity.id] %>"><%= activity.title %></a></h2><p><%= activity.description %></p></div></article><% }) %></section><% } %>
<% if (surface.role === 'offers') { %><section class="cc-territory-editorial__index"><% graph.offers.forEach((offer,index)=>{ %><article><p class="cc-editorial-index"><%= String(index+1).padStart(2,'0') %></p><div><p class="cc-kicker"><%= offer.category || 'Offering' %></p><h2><%= offer.title %></h2><p><%= offer.summary %></p><% if (offer.price) { %><p><strong><%= offer.price %></strong></p><% } %></div></article><% }) %></section><% } %>
<% if (surface.role === 'stories-index') { %><section class="cc-territory-editorial__stories"><% stories.forEach((item,index)=>{ %><article><p class="cc-editorial-index"><%= String(index+1).padStart(2,'0') %> / <%= item.kind.toUpperCase() %></p><h2><a href="<%= storyPaths[item.id] %>"><%= item.title %></a></h2><p class="cc-territory-editorial__lede"><%= item.dek || item.body %></p><% if (item.authors.length) { %><p>By <% item.authors.forEach((a,i)=>{ %><a href="<%= profilePaths[a.id] %>"><%= a.displayName %></a><%= i < item.authors.length-1 ? ', ' : '' %><% }) %></p><% } %></article><% }) %></section><% } %>
<% if (surface.role === 'story-detail') { %><article class="cc-territory-editorial__article"><aside><p class="cc-editorial-index"><%= story.kind.toUpperCase() %></p><% if (story.authors.length) { %><p>By <% story.authors.forEach((a,i)=>{ %><a href="<%= profilePaths[a.id] %>"><%= a.displayName %></a><%= i < story.authors.length-1 ? ', ' : '' %><% }) %></p><% } %></aside><div><% if (story.media[0]) { %><figure><%- include('../../_art',{media:story.media[0],graph}) %><figcaption><%= story.media[0].alt %></figcaption></figure><% } %><p class="cc-territory-editorial__body"><%= story.body %></p></div></article><% } %>
<% if (surface.role === 'gallery') { %><section class="cc-territory-editorial__gallery"><% galleryMedia.forEach((item,index)=>{ %><figure><span class="cc-editorial-index"><%= String(index+1).padStart(2,'0') %></span><%- include('../../_art',{media:item,graph}) %><figcaption><%= item.alt %></figcaption></figure><% }) %></section><% } %>
<% if (surface.role === 'people-index') { %><section class="cc-territory-editorial__index"><% people.forEach((person,index)=>{ %><article><p class="cc-editorial-index"><%= String(index+1).padStart(2,'0') %></p><div><p class="cc-kicker"><%= person.role || 'Contributor' %></p><h2><a href="<%= profilePaths[person.id] %>"><%= person.displayName %></a></h2><p><%= person.bio %></p></div></article><% }) %></section><% } %>
<% if (surface.role === 'profile-detail') { %><article class="cc-territory-editorial__article"><aside><p class="cc-editorial-index">PROFILE</p><p><%= profile.role || 'Contributor' %></p></aside><div><% if (profile.media) { %><figure><%- include('../../_art',{media:profile.media,graph}) %></figure><% } %><p class="cc-territory-editorial__body"><%= profile.bio %></p><% profile.links.forEach((link)=>{ %><p><a class="cc-link" href="<%= link.url %>"><%= link.label %></a></p><% }) %></div></article><% } %>
<% if (surface.role === 'about-visit') { %><section class="cc-territory-editorial__about"><p class="cc-editorial-index">CONTEXT / WHERE</p><div><p class="cc-territory-editorial__body"><%= graph.intent.presenceMaterial %></p><p><%= graph.intent.purpose %></p><h2><%= graph.facts.presence.label %></h2><% if (graph.facts.presence.address) { %><p><%= graph.facts.presence.address %></p><% } %><p><% if (contact.href) { %><a class="cc-link" href="<%= contact.href %>"><%= contact.label %></a><% } else { %><%= contact.label %><% } %></p></div></section><% } %>
</main><footer class="cc-editorial-footer"><span><%= graph.identity.displayName %></span><span><%= graph.facts.presence.label %></span></footer></body></html>
