<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Your places — HiVenues</title><link rel="stylesheet" href="/css/hivenues.css"><link rel="stylesheet" href="/css/hivenues-operator.css"></head>
<body class="op-body"><header class="op-header"><a class="op-home" href="/hivenues">H<span>HiVenues</span></a><span class="op-place">Your places</span><% if (typeof canCreate !== 'undefined' && canCreate) { %><a class="op-button op-button--primary" href="/hivenues/new">Create a place</a><% } %></header>
<main class="op-main op-main--wide"><p class="op-eyebrow">Make it yours</p><h1>Your places</h1><p class="op-lead">Pick up where you left off.</p><div class="op-place-grid">
<% hosts.filter(Boolean).forEach((host) => { %><article class="op-place-card"><div class="op-copy-art op-copy-art--<%= host.family.id %>"><span><%= host.graph.identity.archetype %></span><strong><%= host.graph.facts.tagline %></strong></div><div class="op-place-card-content"><h2><%= host.graph.identity.displayName %></h2><% if (host.operator) { %><p><%= host.operator.title %></p><a class="op-button op-button--primary" href="<%= host.operator.base %>">Edit website</a><a class="op-button" href="<%= host.operator.base %>/website">Website details</a><% } else { %><a class="op-button" href="/hivenues/<%= host.graph.identity.slug %>">View website</a><% if (typeof studioAvailable === 'undefined' || studioAvailable) { %><a class="op-button" href="/hivenues/studio/<%= host.graph.identity.slug %>">Open Studio</a><% } %><% } %></div></article><% }) %>
</div></main></body></html>
