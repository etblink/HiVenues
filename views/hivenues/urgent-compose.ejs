<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_head', { graph, pageTitle }) %>
</head>
<body class="cc-task-body">
  <main class="cc-task cc-task--urgent">
    <nav class="cc-task-nav">
      <a class="cc-link" href="/hivenues/studio/<%= graph.identity.slug %>">Back to Studio</a>
      <span class="cc-draft-status cc-draft-status--live">Latest Website Release · <%= release.kind === 'urgent' ? `Version ${release.draftRevision} + urgent update` : `Version ${release.draftRevision}` %></span>
    </nav>
    <p class="cc-kicker">Urgent update</p>
    <h1>Change one thing in the latest Website Release.</h1>
    <p class="cc-task__dek">
      This starts from the latest Website Release, not from your Working version. It creates a new urgent Website
      Release containing only this status change. Other Working edits stay unreleased, and any external public
      deployment stays unchanged until you explicitly update it.
    </p>

    <% if (noChange) { %>
      <div class="cc-consequence-truth" role="status" data-no-change style="max-width:720px;margin-top:1.5rem">
        <strong>Nothing would change.</strong> That status and note are already in the latest Website Release, so there is no urgent Release to create. Choose a different status or note.
      </div>
    <% } %>
    <% if (notLiveYet) { %>
      <div class="cc-conflict" role="alert" style="max-width:720px;margin-top:1.5rem">
        <strong>That activity is not in the latest Website Release yet.</strong> An urgent update can only change something already present in the latest Website Release. Create a whole Website Release first, then change its status if needed.
      </div>
    <% } %>

    <% if (activity) { %>
      <form class="cc-setup-form cc-urgent-form" method="post" action="/hivenues/studio/<%= graph.identity.slug %>/urgent">
        <div class="cc-field">
          <label for="cc-urgent-activity">Which activity?</label>
          <select id="cc-urgent-activity" name="activityId" required>
            <% liveActivities.forEach((item) => { %>
              <option value="<%= item.id %>" <%= item.id === activity.id ? 'selected' : '' %>><%= item.title %> · currently <%= activityLifecycles[item.lifecycle].label.toLowerCase() %></option>
            <% }) %>
          </select>
          <p class="cc-inspector-help">Listed as it appears in the latest Website Release. If you renamed it in Working without creating a Release, the released title is shown here on purpose.</p>
        </div>
        <fieldset class="cc-field" style="border:0;padding:0;margin:0">
          <legend>New status</legend>
          <div class="cc-choice-grid">
            <% Object.values(activityLifecycles).forEach((option) => { %>
              <label class="cc-choice">
                <input type="radio" name="lifecycle" value="<%= option.id %>" <%= (activity.lifecycle === 'scheduled' ? option.id === 'cancelled' : option.id === activity.lifecycle) ? 'checked' : '' %> required>
                <strong><%= option.label %></strong>
                <small><%= option.id === 'scheduled' ? 'Visitors can RSVP and keep the date.' : option.id === 'cancelled' ? 'Visitors see a clear cancellation and RSVP closes.' : 'Visitors see that it already happened.' %></small>
              </label>
            <% }) %>
          </div>
        </fieldset>
        <div class="cc-field">
          <label for="cc-urgent-note">Short note for visitors <span aria-hidden="true">·</span> optional</label>
          <textarea id="cc-urgent-note" name="statusNote" maxlength="240" rows="2" placeholder="e.g. Tonight is cancelled — tickets are refunded at the door."><%= activity.statusNote || '' %></textarea>
        </div>
        <div class="cc-consequence-truth">
          <strong>What happens next</strong><br>
          You will review exactly what changes before a new immutable Website Release is created. This does not broadcast to Hive, request a signature, move value, upload media, mutate a provider, update an external deployment, or touch DNS.
        </div>
        <div class="cc-inspector-actions">
          <button class="cc-button cc-button--ink" type="submit">Review the change</button>
          <a class="cc-link" href="/hivenues/studio/<%= graph.identity.slug %>/release">Create the whole Website Release instead</a>
        </div>
      </form>
    <% } else { %>
      <p class="cc-task__dek">There are no activities in the latest Website Release to update.</p>
    <% } %>
  </main>
</body>
</html>
