#!/bin/bash
set -Eeuo pipefail
umask 077

readonly payment_dir=/var/lib/hive-bar/payments
readonly receipt_db="$payment_dir/receipts.sqlite3"
readonly release_root=/opt/hive-bar/current
readonly prepare_script="$release_root/scripts/prepare-payment-storage.js"

fail() {
  printf 'Hive-Bar payment storage preparation refused: %s\n' "$1" >&2
  exit 1
}

[[ $EUID -eq 0 ]] || fail 'run as root'
[[ -d /var/lib/hive-bar && ! -L /var/lib/hive-bar ]] || fail '/var/lib/hive-bar must be an existing non-symlink directory'
[[ -f "$prepare_script" && ! -L "$prepare_script" ]] || fail 'the installed release does not contain the reviewed payment storage initializer'

if [[ -e "$payment_dir" || -L "$payment_dir" ]]; then
  [[ -d "$payment_dir" && ! -L "$payment_dir" ]] || fail 'payment directory must be a regular non-symlink directory'
  chown hivebar:hivebar "$payment_dir"
  chmod 0700 "$payment_dir"
else
  install -d -o hivebar -g hivebar -m 0700 "$payment_dir"
fi

if [[ -e "$receipt_db" ]]; then
  [[ -f "$receipt_db" && ! -L "$receipt_db" ]] || fail 'receipt database must be a regular non-symlink file'
  chown hivebar:hivebar "$receipt_db"
  chmod 0600 "$receipt_db"
else
  install -o hivebar -g hivebar -m 0600 /dev/null "$receipt_db"
fi

runuser -u hivebar -- /usr/local/bin/node "$prepare_script" "$receipt_db" >/dev/null
chown hivebar:hivebar "$receipt_db"
chmod 0600 "$receipt_db"
printf 'Hive-Bar payment storage ready at %s. Pay was not enabled.\n' "$receipt_db"
