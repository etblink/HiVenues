#!/bin/bash
set -Eeuo pipefail
umask 027

readonly app_root=/opt/hive-bar
readonly repository="$app_root/repository.git"
readonly releases="$app_root/releases"
readonly current="$app_root/current"
readonly environment_file=/etc/hive-bar/hive-bar.env
readonly runtime=/usr/local/bin/node
readonly service=hive-bar.service

health_url=
readiness_url=
gate_failure=NOT_RUN

fail() {
  printf 'Hive-Bar rollback refused: %s\n' "$1" >&2
  exit 1
}

load_probe_urls() {
  local output
  local -a urls
  if ! output="$(
    runuser -u hivebar -- env -i \
      HOME=/nonexistent PATH=/usr/local/bin:/usr/bin:/bin RELEASE_ROOT="$release" \
      "$runtime" <<'NODE'
'use strict';
const fs = require('node:fs');
const path = require('node:path');
const releaseRoot = process.env.RELEASE_ROOT;
const manifestPath = path.join(releaseRoot, 'ops', 'privex', 'manifest.json');
const profilePath = path.join(releaseRoot, 'src', 'deployment', 'profile.js');
const manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));
let base;
let healthPath;
let readinessPath;
if (fs.existsSync(profilePath)) {
  const { compileDeploymentProfile } = require(profilePath);
  const profile = compileDeploymentProfile(manifest);
  const application = profile.topology.application;
  base = `http://${application.bindHost}:${application.port}`;
  healthPath = profile.release.healthPath;
  readinessPath = profile.release.readinessPath;
} else {
  const applicationAddress = String(manifest?.topology?.applicationAddress || '').trim();
  healthPath = String(manifest?.release?.healthPath || '').trim();
  readinessPath = String(manifest?.release?.readinessPath || '').trim();
  const applicationUrl = new URL(`http://${applicationAddress}`);
  const port = Number(applicationUrl.port);
  if (
    applicationUrl.hostname !== '127.0.0.1' ||
    !Number.isInteger(port) ||
    port < 1 ||
    port > 65535 ||
    applicationUrl.pathname !== '/' ||
    applicationUrl.search ||
    applicationUrl.hash ||
    applicationUrl.username ||
    applicationUrl.password
  ) {
    throw new Error('legacy Privex applicationAddress must be a loopback host:port');
  }
  const routePattern = /^\/(?!\/)[^?#\s]*$/;
  if (!routePattern.test(healthPath) || !routePattern.test(readinessPath) || healthPath === readinessPath) {
    throw new Error('legacy Privex health/readiness routes are malformed');
  }
  base = applicationUrl.origin;
}
process.stdout.write(`${base}${healthPath}\n${base}${readinessPath}\n`);
NODE
  )"; then
    fail 'release health/readiness probe URLs could not be derived from the reviewed deployment profile'
  fi
  mapfile -t urls <<<"$output"
  [[ ${#urls[@]} -eq 2 && -n "${urls[0]}" && -n "${urls[1]}" ]] || \
    fail 'release health/readiness probe URLs were malformed'
  health_url="${urls[0]}"
  readiness_url="${urls[1]}"
}

readiness_body_is_ready() {
  [[ "$1" == '{"status":"ready"}' ]]
}

release_gate_check() {
  local response http_status health readiness

  gate_failure=HEALTH_UNREACHABLE
  response="$(curl --silent --show-error --max-time 5 --write-out $'\n%{http_code}' "$health_url" 2>/dev/null)" || return 1
  http_status="${response##*$'\n'}"
  health="${response%$'\n'*}"
  if [[ "$http_status" != 200 ]]; then
    gate_failure="HEALTH_HTTP_$http_status"
    return 1
  fi
  if [[ "$health" != *'"writeMode":"disabled"'* ||
        "$health" != *"\"build\":\"$build\""* ||
        "$health" != *"\"commit\":\"$commit\""* ||
        "$health" != *"\"tree\":\"$tree\""* ]]; then
    gate_failure=HEALTH_IDENTITY_MISMATCH
    return 1
  fi

  gate_failure=READINESS_UNREACHABLE
  response="$(curl --silent --show-error --max-time 5 --write-out $'\n%{http_code}' "$readiness_url" 2>/dev/null)" || return 1
  http_status="${response##*$'\n'}"
  readiness="${response%$'\n'*}"
  if [[ "$http_status" != 200 ]]; then
    gate_failure="READINESS_HTTP_$http_status"
    return 1
  fi
  if ! readiness_body_is_ready "$readiness"; then
    gate_failure=READINESS_NOT_READY
    return 1
  fi

  gate_failure=NONE
  return 0
}

gate_failure_reason() {
  case "$gate_failure" in
    HEALTH_*) printf 'health identity gate failed (%s)' "$gate_failure" ;;
    READINESS_*) printf 'readiness gate failed (%s)' "$gate_failure" ;;
    *) printf 'release gate failed (%s)' "$gate_failure" ;;
  esac
}

restore_previous_release() {
  [[ -n "$previous" && -d "$previous" ]] || return 0
  local recovery_link="$app_root/.current.recovery.$$"
  ln -s "$previous" "$recovery_link"
  mv -Tf "$recovery_link" "$current"
  systemctl restart "$service"
}

[[ $EUID -eq 0 ]] || fail 'run as root'
[[ $# -eq 1 ]] || fail 'provide exactly one previously installed full commit SHA'
commit="$1"
[[ "$commit" =~ ^[0-9a-f]{40}$ ]] || fail 'commit must be 40 lowercase hexadecimal characters'
[[ -d "$repository" ]] || fail 'the reviewed bare repository is missing'
[[ -r "$environment_file" ]] || fail 'the protected environment file is missing'
[[ "$(stat -c '%U:%G:%a' "$environment_file")" == 'root:hivebar:640' ]] || fail 'the environment file must be root:hivebar mode 0640'
[[ -x "$runtime" ]] || fail 'the pinned Node runtime is missing'
[[ "$($runtime --version)" == 'v24.19.0' ]] || fail 'the Node runtime is not v24.19.0'
release="$releases/$commit"
[[ -d "$release" ]] || fail 'the requested release is not installed'
[[ -r "$release/.hive-bar-commit" ]] || fail 'the release commit identity record is missing'
[[ -r "$release/.hive-bar-tree" ]] || fail 'the release tree identity record is missing'
[[ "$(<"$release/.hive-bar-commit")" == "$commit" ]] || fail 'the release commit identity record does not match'
tree="$(<"$release/.hive-bar-tree")"
[[ "$tree" =~ ^[0-9a-f]{40}$ ]] || fail 'the release tree identity record is malformed'
git --git-dir="$repository" cat-file -e "${commit}^{commit}" 2>/dev/null || fail 'the requested commit is absent from the reviewed repository'
expected_tree="$(git --git-dir="$repository" rev-parse "${commit}^{tree}")"
[[ "$tree" == "$expected_tree" ]] || fail 'the release tree identity does not match the reviewed repository'
subject="$(git --git-dir="$repository" log -1 --format=%s "$commit")"
build="beta-${commit:0:7}"

runuser -u hivebar -- env -i HOME=/nonexistent PATH=/usr/local/bin:/usr/bin:/bin sh -c '
  set -eu
  set -a
  . /etc/hive-bar/hive-bar.env
  set +a
  PATH=/usr/local/bin:/usr/bin:/bin
  export PATH
  cd "$1"
  node scripts/check-privex-release.js
' sh "$release"

load_probe_urls

previous="$(readlink -f "$current" 2>/dev/null || true)"
next_link="$app_root/.current.rollback.${commit}.$$"
ln -s "$release" "$next_link"
mv -Tf "$next_link" "$current"
systemctl restart "$service"

for _attempt in {1..20}; do
  if release_gate_check; then
    rolled_back_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    printf 'Hive-Bar rolled back to %s exact commit %s tree %s at %s subject: %s\n' "$build" "$commit" "$tree" "$rolled_back_at" "$subject"
    exit 0
  fi
  sleep 1
done

restore_previous_release
fail "rollback target $(gate_failure_reason); the prior release was restored when available"
