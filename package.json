{
  "name": "hivenues",
  "version": "1.0.0",
  "description": "HiVenues is a premium, host-first frontend factory for Hive.",
  "private": true,
  "main": "src/product/app.js",
  "engines": {
    "node": ">=24.15 <25",
    "npm": ">=11"
  },
  "scripts": {
    "start": "node scripts/hivenues-studio.js",
    "dev": "npm run build:css && node --watch scripts/hivenues-studio.js",
    "build": "npm run build:css",
    "build:css": "tailwindcss --cwd ./views -i ../src/input.css -o ../public/css/style.css --minify",
    "watch:css": "tailwindcss --cwd ./views -i ../src/input.css -o ../public/css/style.css --watch",
    "smoke:live": "node scripts/live-read-smoke.js",
    "release:check:runtime": "node scripts/check-pinned-runtime.js",
    "lint": "eslint src public/js test scripts eslint.config.js --max-warnings=0",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-concurrency=1 test/*.test.js",
    "check:secrets": "node scripts/check-secrets.js",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:prod:ci": "node scripts/run-npm-audit-ci.js",
    "check:deterministic": "npm run check:secrets && npm run lint && npm run build && npm test",
    "check": "npm run check:deterministic && npm run audit:prod:ci",
    "test:browser": "node scripts/product-browser-qualification.js"
  },
  "dependencies": {
    "@zxing/browser": "0.2.1",
    "compression": "1.8.1",
    "dotenv": "17.4.2",
    "ejs": "6.0.1",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "hive-tx": "7.2.0",
    "htmx.org": "2.0.10",
    "markdown-it": "15.0.0",
    "pino": "10.3.1",
    "sanitize-html": "2.17.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "axe-core": "4.13.0",
    "eslint": "10.0.0",
    "html-validate": "11.6.2",
    "jsdom": "29.1.1",
    "playwright": "1.62.1",
    "supertest": "7.2.2",
    "tailwindcss": "4.3.3"
  },
  "packageManager": "npm@11.17.0",
  "license": "AGPL-3.0-or-later"
}
